      {
        "id": "66135e6a4c6343debcfc72e481361256",
        "type": "flograph.viz.show_web",
        "pos": [
          380,
          140
        ],
        "params": {
          "width": 560,
          "height": 360,
          "scale": 100
        },
        "code": "\"\"\"Sales Dashboard\n\nA Show Web View forked into a hand-written HTML dashboard \u2014 CSS grid,\ngradients, rounded cards, a web font stack. The point of the example: this\nis what the *card* shows, and now it is what the report page shows too.\n\"\"\"\nNODE = {\n    \"label\": \"Sales Dashboard\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"data\", \"dataframe\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600, \"cosmetic\": True},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 360, \"min\": 200, \"max\": 2000, \"cosmetic\": True},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400, \"cosmetic\": True},\n]\n\n\ndef run(ctx, data):\n    total = float(data[\"revenue\"].sum())\n    orders = int(data[\"orders\"].sum())\n    growth = float(data[\"growth\"].mean())\n    top = data.sort_values(\"revenue\", ascending=False).iloc[0]\n    most = float(data[\"revenue\"].max())\n\n    bars = \"\"\n    for row in data.itertuples(index=False):\n        share = (float(row.revenue) / most) if most else 0.0\n        bars += (\n            f\"<div class='row'><span class='name'>{row.region}</span>\"\n            f\"<span class='track'><i style='width:{share * 100:.0f}%'></i>\"\n            f\"</span>\"\n            f\"<span class='val'>\u00a3{row.revenue / 1000:,.0f}k</span></div>\")\n\n    ctx.log(f\"rendered {len(data)} regions\")\n    return f\"\"\"\n<div class=\"wrap\">\n  <header>\n    <h1>Regional performance</h1>\n    <p>Quarter to date &middot; all channels</p>\n  </header>\n  <div class=\"kpis\">\n    <div class=\"kpi\"><b>\u00a3{total / 1e6:,.2f}m</b><span>revenue</span></div>\n    <div class=\"kpi\"><b>{orders:,}</b><span>orders</span></div>\n    <div class=\"kpi {'up' if growth >= 0 else 'down'}\">\n      <b>{growth:+.1%}</b><span>avg growth</span></div>\n    <div class=\"kpi\"><b>{top.region}</b><span>top region</span></div>\n  </div>\n  <div class=\"bars\">{bars}</div>\n</div>\n<style>\n  html, body {{ margin: 0; padding: 0; background: #0f172a; }}\n  .wrap {{ font-family: \"Segoe UI\", system-ui, sans-serif; color: #e2e8f0;\n          padding: 22px 24px; }}\n  header h1 {{ margin: 0 0 2px; font-size: 21px; letter-spacing: -0.01em; }}\n  header p {{ margin: 0 0 18px; color: #7c8aa5; font-size: 12px; }}\n  .kpis {{ display: grid; grid-template-columns: repeat(4, 1fr);\n           gap: 10px; margin-bottom: 20px; }}\n  .kpi {{ background: linear-gradient(160deg, #1e293b, #172033);\n          border: 1px solid #2b3a52; border-radius: 12px;\n          padding: 12px 14px; }}\n  .kpi b {{ display: block; font-size: 19px; color: #38bdf8;\n            letter-spacing: -0.02em; }}\n  .kpi span {{ font-size: 11px; color: #8ea0bd; }}\n  .kpi.up b {{ color: #4ade80; }}\n  .kpi.down b {{ color: #fb7185; }}\n  .row {{ display: flex; align-items: center; gap: 10px;\n          margin-bottom: 9px; font-size: 12px; }}\n  .name {{ width: 62px; color: #cbd5e1; }}\n  .track {{ flex: 1; height: 9px; background: #1e293b;\n            border-radius: 5px; overflow: hidden; }}\n  .track i {{ display: block; height: 100%;\n              background: linear-gradient(90deg, #38bdf8, #a855f7); }}\n  .val {{ width: 58px; text-align: right; color: #94a3b8; }}\n</style>\n\"\"\"\n",
        "label": "Sales Dashboard",
        "description": "",
