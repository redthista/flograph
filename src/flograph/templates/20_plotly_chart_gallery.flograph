  "nodes": [
   {
    "id": "n00_intro",
    "type": "flograph.util.note",
    "pos": [
     0,
     0
    ],
    "params": {
     "text": "## Every chart Plotly draws\n\nOne table of hardware sales, charted eight ways. Each band below is a\nfamily of chart the **Show Plotly** node now covers, with a note saying\nwhat to look at and which settings made it.\n\nPick any chart node and watch the **Properties** panel: you only ever see\nthe settings the chosen **Kind** actually has. Tick **More options** to\nreveal the rest \u2014 that tick is cosmetic, so nothing re-runs.\n\nPress **F5** to run the whole thing.",
     "width": 760,
     "height": 320
    },
    "code": null,
    "label": null
   },
   {
    "id": "n01_sales",
    "type": "flograph.io.table",
    "pos": [
     0,
     420
    ],
    "params": {
     "data": "{\"version\": 2, \"columns\": [{\"name\": \"region\", \"type\": \"text\"}, {\"name\": \"city\", \"type\": \"text\"}, {\"name\": \"category\", \"type\": \"text\"}, {\"name\": \"month\", \"type\": \"date\"}, {\"name\": \"units\", \"type\": \"integer\"}, {\"name\": \"revenue\", \"type\": \"number\"}, {\"name\": \"cost\", \"type\": \"number\"}], \"rows\": [[\"North\", \"Leeds\", \"Tools\", \"2026-01-01\", 122, 2566.13, 1557.28], [\"North\", \"Leeds\", \"Tools\", \"2026-02-01\", 52, 883.22, 563.4], [\"North\", \"Leeds\", \"Paint\", \"2026-01-01\", 133, 1529.85, 1101.7], [\"North\", \"Leeds\", \"Paint\", \"2026-02-01\", 94, 940.29, 578.66], [\"North\", \"York\", \"Tools\", \"2026-01-01\", 57, 1012.49, 649.24], [\"North\", \"York\", \"Tools\", \"2026-02-01\", 55, 1126.08, 616.23], [\"North\", \"York\", \"Paint\", \"2026-01-01\", 97, 1128.52, 731.57], [\"North\", \"York\", \"Paint\", \"2026-02-01\", 55, 631.79, 383.67], [\"South\", \"Bath\", \"Tools\", \"2026-01-01\", 96, 1619.08, 1147.71], [\"South\", \"Bath\", \"Tools\", \"2026-02-01\", 114, 2119.09, 1353.99], [\"South\", \"Bath\", \"Paint\", \"2026-01-01\", 186, 1999.19, 1398.53], [\"South\", \"Bath\", \"Paint\", \"2026-02-01\", 86, 875.77, 565.45], [\"South\", \"Exeter\", \"Tools\", \"2026-01-01\", 88, 1616.77, 1035.55], [\"South\", \"Exeter\", \"Tools\", \"2026-02-01\", 56, 1078.57, 707.74], [\"South\", \"Exeter\", \"Paint\", \"2026-01-01\", 167, 1965.77, 1207.12], [\"South\", \"Exeter\", \"Paint\", \"2026-02-01\", 120, 1341.65, 970.22], [\"East\", \"Norwich\", \"Tools\", \"2026-01-01\", 132, 2380.81, 1654.1], [\"East\", \"Norwich\", \"Tools\", \"2026-02-01\", 218, 4415.96, 2375.82], [\"East\", \"Norwich\", \"Paint\", \"2026-01-01\", 116, 1315.94, 937.65], [\"East\", \"Norwich\", \"Paint\", \"2026-02-01\", 226, 2516.35, 1645.62], [\"East\", \"Ipswich\", \"Tools\", \"2026-01-01\", 58, 997.37, 610.38], [\"East\", \"Ipswich\", \"Tools\", \"2026-02-01\", 233, 4248.06, 3081.2], [\"East\", \"Ipswich\", \"Paint\", \"2026-01-01\", 147, 1471.15, 981.27], [\"East\", \"Ipswich\", \"Paint\", \"2026-02-01\", 235, 2687.16, 1863.82]]}",
     "width": 620,
     "height": 360
    },
    "code": null,
    "label": "Sales"
   },
   {
    "id": "n02_goto",
