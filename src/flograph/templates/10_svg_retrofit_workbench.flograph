   {
    "id": "svg_page_orig",
    "type": "flograph.scripting.python_script",
    "pos": [
     -300,
     -1060
    ],
    "params": {
     "banner": "Before \u00b7 original artwork",
     "banner_color": "#0284c7"
    },
    "code": "\"\"\"Prepare Page\n\nMakes a page previewable, and \u2014 when an SVG is wired in \u2014 swaps the new\nartwork into it so you can see the retrofit working on the real page rather\nthan on a table describing it.\n\nWith no SVG connected it passes the page through untouched, which is how the\nsame node renders the *before* view.\n\nThe preview renders from a temp file, so the page needs telling where its\nown folder is or `styles.css` and `app.js` resolve against the wrong\ndirectory and quietly never load \u2014 a page that looks nearly right and does\nnothing at all. A <base> tag pointing at the real folder is the whole fix,\nand it is the *only* thing done here: pulling the assets inline instead\nloses `defer` on a script tag, which moves the script from after the\ndocument to before it, so every `getElementById` in it returns null and no\nhandler is ever bound. The page still looks fine. Nothing works.\n\nRoot-absolute URLs \u2014 `/assets/app.js`, written for a site served from a web\nroot \u2014 have no directory to be relative to and <base> cannot rescue them, so\nthose are rewritten to the page's folder when the file is actually there.\n\n**Path is not optional in practice.** With no path there is no folder, no\nbase, and no external asset will load. The node says so rather than\nproducing a dead page in silence.\n\"\"\"\nimport re\n\nNODE = {\n    \"label\": \"Prepare Page\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\"), (\"svg\", \"string\", {\"optional\": True}),\n               (\"path\", \"string\", {\"optional\": True})],\n    \"outputs\": [(\"html\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"which\", \"type\": \"int\", \"label\": \"Which <svg> (1-based)\",\n     \"default\": 1, \"min\": 1, \"max\": 50},\n    {\"name\": \"fix_absolute_urls\", \"type\": \"bool\",\n     \"label\": \"Repoint /root-absolute asset URLs at the page's folder\",\n     \"default\": True},\n    {\"name\": \"banner\", \"type\": \"string\", \"label\": \"Corner banner\",\n     \"default\": \"\", \"placeholder\": \"e.g. Before \u2014 original artwork\"},\n    {\"name\": \"banner_color\", \"type\": \"string\", \"label\": \"Banner colour\",\n     \"default\": \"#0ea5e9\"},\n]\n\n# Depth-counted rather than non-greedy, so a nested <svg> cannot make the\n# swap replace half the artwork and leave the rest of it behind.\n_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n_ROOT_URL = re.compile(\n    r\"\"\"\\b(src|href)\\s*=\\s*(['\"])/(?!/)([^'\"]*)\\2\"\"\", re.I)\n_ROOT_CSS_URL = re.compile(r\"\"\"\\burl\\(\\s*(['\"]?)/(?!/)([^'\")]*)\\1\\s*\\)\"\"\", re.I)\n_BODY = re.compile(r\"<body\\b[^>]*>\", re.I)\n_HEAD = re.compile(r\"<head\\b[^>]*>\", re.I)\n_HTML = re.compile(r\"<html\\b[^>]*>\", re.I)\n_ASSET = re.compile(\n    r\"\"\"<(link|script|img)\\b[^>]*\\b(?:src|href)\\s*=\\s*['\"]([^'\"]+)['\"]\"\"\", re.I)\n\n\ndef _relative(url):\n    \"\"\"A URL that needs a folder to be found from.\"\"\"\n    return not re.match(r\"^(?:[a-z][\\w+.-]*:)?//|^data:|^#|^[a-z][\\w+.-]*:\",\n                        url or \"\", re.I)\n\n\ndef _blocks(page):\n    \"\"\"(start, end) of every top-level <svg> \u2026 </svg> in document order.\"\"\"\n    found, depth, start = [], 0, None\n    for match in _TAG.finditer(page):\n        if match.group(1):\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif match.group(2).rstrip().endswith(\"/\"):\n            if depth == 0:\n                found.append((match.start(), match.end()))\n        else:\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:\n        found.append((start, len(page)))\n    return found\n\n\ndef run(ctx, html, svg=None, path=None):\n    from pathlib import Path\n\n    page = html or \"\"\n    if not page.strip():\n        raise ValueError(\"no HTML on the input\")\n\n    if svg:\n        blocks = _blocks(page)\n        which = int(ctx.params[\"which\"])\n        if not blocks:\n            raise ValueError(\"no inline <svg> in the page to replace\")\n        if which > len(blocks):\n            raise ValueError(f\"the page has {len(blocks)} <svg> block(s), \"\n                             f\"asked for #{which}\")\n        start, end = blocks[which - 1]\n        page = page[:start] + svg + page[end:]\n        ctx.log(f\"swapped in {len(svg):,} chars of artwork\")\n\n    base = Path(path).parent if path else None\n    if base is None:\n        # Only a problem if the page actually reaches outside itself \u2014 a\n        # self-contained page with its style and script inline needs nothing.\n        outside = [url for _tag, url in _ASSET.findall(page) if _relative(url)]\n        if outside:\n            ctx.log(\n                f\"WARNING: no page path, and this page loads {len(outside)} \"\n                f\"external file(s) \u2014 {', '.join(sorted(set(outside))[:3])}\"\n                f\"{' \u2026' if len(set(outside)) > 3 else ''}. None of them can be \"\n                f\"found from here, so the preview will render unstyled and \"\n                f\"nothing on it will respond. Set Path on the Source File node.\"\n            )\n    else:\n        if bool(ctx.params[\"fix_absolute_urls\"]):\n            repointed = 0\n\n            def repoint(url):\n                \"\"\"A '/assets/app.js' that exists under the page's folder.\"\"\"\n                candidate = (base / url.lstrip(\"/\")).resolve()\n                return candidate if candidate.is_file() else None\n\n            def attribute(match):\n                nonlocal repointed\n                name, quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'{name}={quote}{target.as_uri()}{quote}'\n\n            def css_url(match):\n                nonlocal repointed\n                quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'url({quote}{target.as_uri()}{quote})'\n\n            page = _ROOT_URL.sub(attribute, page)\n            page = _ROOT_CSS_URL.sub(css_url, page)\n            if repointed:\n                ctx.log(f\"repointed {repointed} root-absolute URL(s) at {base}\")\n\n        # Before everything, so it governs every relative URL on the page \u2014\n        # and only if the page has not set one of its own.\n        if not re.search(r\"<base\\b\", page, re.I):\n            tag = f'<base href=\"{base.as_uri()}/\">'\n            anchor = _HEAD.search(page) or _HTML.search(page)\n            page = ((page[:anchor.end()] + tag + page[anchor.end():])\n                    if anchor else tag + page)\n            ctx.log(f\"assets resolve against {base}\")\n\n    banner = (ctx.params[\"banner\"] or \"\").strip()\n    if banner:\n        colour = (ctx.params[\"banner_color\"] or \"#0ea5e9\").strip()\n        ribbon = (\n            f'<div style=\"position:fixed;top:10px;right:10px;z-index:99999;'\n            f'font:600 11px/1 ui-sans-serif,system-ui,sans-serif;'\n            f'letter-spacing:.08em;text-transform:uppercase;color:#fff;'\n            f'background:{colour};padding:7px 11px;border-radius:999px;'\n            f'box-shadow:0 2px 10px rgba(0,0,0,.35);pointer-events:none;\">'\n            f'{banner}</div>'\n        )\n        body = _BODY.search(page)\n        page = (page[:body.end()] + ribbon + page[body.end():]) if body else ribbon + page\n\n    return {\"html\": page}\n",
    "label": "Page \u00b7 original"
   },
   {
    "id": "svg_page_raw",
    "type": "flograph.scripting.python_script",
    "pos": [
     -300,
     -520
    ],
    "params": {
     "banner": "New SVG, no retrofit",
     "banner_color": "#dc2626"
    },
    "code": "\"\"\"Prepare Page\n\nMakes a page previewable, and \u2014 when an SVG is wired in \u2014 swaps the new\nartwork into it so you can see the retrofit working on the real page rather\nthan on a table describing it.\n\nWith no SVG connected it passes the page through untouched, which is how the\nsame node renders the *before* view.\n\nThe preview renders from a temp file, so the page needs telling where its\nown folder is or `styles.css` and `app.js` resolve against the wrong\ndirectory and quietly never load \u2014 a page that looks nearly right and does\nnothing at all. A <base> tag pointing at the real folder is the whole fix,\nand it is the *only* thing done here: pulling the assets inline instead\nloses `defer` on a script tag, which moves the script from after the\ndocument to before it, so every `getElementById` in it returns null and no\nhandler is ever bound. The page still looks fine. Nothing works.\n\nRoot-absolute URLs \u2014 `/assets/app.js`, written for a site served from a web\nroot \u2014 have no directory to be relative to and <base> cannot rescue them, so\nthose are rewritten to the page's folder when the file is actually there.\n\n**Path is not optional in practice.** With no path there is no folder, no\nbase, and no external asset will load. The node says so rather than\nproducing a dead page in silence.\n\"\"\"\nimport re\n\nNODE = {\n    \"label\": \"Prepare Page\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\"), (\"svg\", \"string\", {\"optional\": True}),\n               (\"path\", \"string\", {\"optional\": True})],\n    \"outputs\": [(\"html\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"which\", \"type\": \"int\", \"label\": \"Which <svg> (1-based)\",\n     \"default\": 1, \"min\": 1, \"max\": 50},\n    {\"name\": \"fix_absolute_urls\", \"type\": \"bool\",\n     \"label\": \"Repoint /root-absolute asset URLs at the page's folder\",\n     \"default\": True},\n    {\"name\": \"banner\", \"type\": \"string\", \"label\": \"Corner banner\",\n     \"default\": \"\", \"placeholder\": \"e.g. Before \u2014 original artwork\"},\n    {\"name\": \"banner_color\", \"type\": \"string\", \"label\": \"Banner colour\",\n     \"default\": \"#0ea5e9\"},\n]\n\n# Depth-counted rather than non-greedy, so a nested <svg> cannot make the\n# swap replace half the artwork and leave the rest of it behind.\n_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n_ROOT_URL = re.compile(\n    r\"\"\"\\b(src|href)\\s*=\\s*(['\"])/(?!/)([^'\"]*)\\2\"\"\", re.I)\n_ROOT_CSS_URL = re.compile(r\"\"\"\\burl\\(\\s*(['\"]?)/(?!/)([^'\")]*)\\1\\s*\\)\"\"\", re.I)\n_BODY = re.compile(r\"<body\\b[^>]*>\", re.I)\n_HEAD = re.compile(r\"<head\\b[^>]*>\", re.I)\n_HTML = re.compile(r\"<html\\b[^>]*>\", re.I)\n_ASSET = re.compile(\n    r\"\"\"<(link|script|img)\\b[^>]*\\b(?:src|href)\\s*=\\s*['\"]([^'\"]+)['\"]\"\"\", re.I)\n\n\ndef _relative(url):\n    \"\"\"A URL that needs a folder to be found from.\"\"\"\n    return not re.match(r\"^(?:[a-z][\\w+.-]*:)?//|^data:|^#|^[a-z][\\w+.-]*:\",\n                        url or \"\", re.I)\n\n\ndef _blocks(page):\n    \"\"\"(start, end) of every top-level <svg> \u2026 </svg> in document order.\"\"\"\n    found, depth, start = [], 0, None\n    for match in _TAG.finditer(page):\n        if match.group(1):\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif match.group(2).rstrip().endswith(\"/\"):\n            if depth == 0:\n                found.append((match.start(), match.end()))\n        else:\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:\n        found.append((start, len(page)))\n    return found\n\n\ndef run(ctx, html, svg=None, path=None):\n    from pathlib import Path\n\n    page = html or \"\"\n    if not page.strip():\n        raise ValueError(\"no HTML on the input\")\n\n    if svg:\n        blocks = _blocks(page)\n        which = int(ctx.params[\"which\"])\n        if not blocks:\n            raise ValueError(\"no inline <svg> in the page to replace\")\n        if which > len(blocks):\n            raise ValueError(f\"the page has {len(blocks)} <svg> block(s), \"\n                             f\"asked for #{which}\")\n        start, end = blocks[which - 1]\n        page = page[:start] + svg + page[end:]\n        ctx.log(f\"swapped in {len(svg):,} chars of artwork\")\n\n    base = Path(path).parent if path else None\n    if base is None:\n        # Only a problem if the page actually reaches outside itself \u2014 a\n        # self-contained page with its style and script inline needs nothing.\n        outside = [url for _tag, url in _ASSET.findall(page) if _relative(url)]\n        if outside:\n            ctx.log(\n                f\"WARNING: no page path, and this page loads {len(outside)} \"\n                f\"external file(s) \u2014 {', '.join(sorted(set(outside))[:3])}\"\n                f\"{' \u2026' if len(set(outside)) > 3 else ''}. None of them can be \"\n                f\"found from here, so the preview will render unstyled and \"\n                f\"nothing on it will respond. Set Path on the Source File node.\"\n            )\n    else:\n        if bool(ctx.params[\"fix_absolute_urls\"]):\n            repointed = 0\n\n            def repoint(url):\n                \"\"\"A '/assets/app.js' that exists under the page's folder.\"\"\"\n                candidate = (base / url.lstrip(\"/\")).resolve()\n                return candidate if candidate.is_file() else None\n\n            def attribute(match):\n                nonlocal repointed\n                name, quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'{name}={quote}{target.as_uri()}{quote}'\n\n            def css_url(match):\n                nonlocal repointed\n                quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'url({quote}{target.as_uri()}{quote})'\n\n            page = _ROOT_URL.sub(attribute, page)\n            page = _ROOT_CSS_URL.sub(css_url, page)\n            if repointed:\n                ctx.log(f\"repointed {repointed} root-absolute URL(s) at {base}\")\n\n        # Before everything, so it governs every relative URL on the page \u2014\n        # and only if the page has not set one of its own.\n        if not re.search(r\"<base\\b\", page, re.I):\n            tag = f'<base href=\"{base.as_uri()}/\">'\n            anchor = _HEAD.search(page) or _HTML.search(page)\n            page = ((page[:anchor.end()] + tag + page[anchor.end():])\n                    if anchor else tag + page)\n            ctx.log(f\"assets resolve against {base}\")\n\n    banner = (ctx.params[\"banner\"] or \"\").strip()\n    if banner:\n        colour = (ctx.params[\"banner_color\"] or \"#0ea5e9\").strip()\n        ribbon = (\n            f'<div style=\"position:fixed;top:10px;right:10px;z-index:99999;'\n            f'font:600 11px/1 ui-sans-serif,system-ui,sans-serif;'\n            f'letter-spacing:.08em;text-transform:uppercase;color:#fff;'\n            f'background:{colour};padding:7px 11px;border-radius:999px;'\n            f'box-shadow:0 2px 10px rgba(0,0,0,.35);pointer-events:none;\">'\n            f'{banner}</div>'\n        )\n        body = _BODY.search(page)\n        page = (page[:body.end()] + ribbon + page[body.end():]) if body else ribbon + page\n\n    return {\"html\": page}\n",
    "label": "Page \u00b7 new SVG dropped straight in"
   },
   {
    "id": "svg_page_fixed",
    "type": "flograph.scripting.python_script",
    "pos": [
     -300,
     20
    ],
    "params": {
     "banner": "After \u00b7 ids restored",
     "banner_color": "#16a34a"
    },
    "code": "\"\"\"Prepare Page\n\nMakes a page previewable, and \u2014 when an SVG is wired in \u2014 swaps the new\nartwork into it so you can see the retrofit working on the real page rather\nthan on a table describing it.\n\nWith no SVG connected it passes the page through untouched, which is how the\nsame node renders the *before* view.\n\nThe preview renders from a temp file, so the page needs telling where its\nown folder is or `styles.css` and `app.js` resolve against the wrong\ndirectory and quietly never load \u2014 a page that looks nearly right and does\nnothing at all. A <base> tag pointing at the real folder is the whole fix,\nand it is the *only* thing done here: pulling the assets inline instead\nloses `defer` on a script tag, which moves the script from after the\ndocument to before it, so every `getElementById` in it returns null and no\nhandler is ever bound. The page still looks fine. Nothing works.\n\nRoot-absolute URLs \u2014 `/assets/app.js`, written for a site served from a web\nroot \u2014 have no directory to be relative to and <base> cannot rescue them, so\nthose are rewritten to the page's folder when the file is actually there.\n\n**Path is not optional in practice.** With no path there is no folder, no\nbase, and no external asset will load. The node says so rather than\nproducing a dead page in silence.\n\"\"\"\nimport re\n\nNODE = {\n    \"label\": \"Prepare Page\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\"), (\"svg\", \"string\", {\"optional\": True}),\n               (\"path\", \"string\", {\"optional\": True})],\n    \"outputs\": [(\"html\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"which\", \"type\": \"int\", \"label\": \"Which <svg> (1-based)\",\n     \"default\": 1, \"min\": 1, \"max\": 50},\n    {\"name\": \"fix_absolute_urls\", \"type\": \"bool\",\n     \"label\": \"Repoint /root-absolute asset URLs at the page's folder\",\n     \"default\": True},\n    {\"name\": \"banner\", \"type\": \"string\", \"label\": \"Corner banner\",\n     \"default\": \"\", \"placeholder\": \"e.g. Before \u2014 original artwork\"},\n    {\"name\": \"banner_color\", \"type\": \"string\", \"label\": \"Banner colour\",\n     \"default\": \"#0ea5e9\"},\n]\n\n# Depth-counted rather than non-greedy, so a nested <svg> cannot make the\n# swap replace half the artwork and leave the rest of it behind.\n_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n_ROOT_URL = re.compile(\n    r\"\"\"\\b(src|href)\\s*=\\s*(['\"])/(?!/)([^'\"]*)\\2\"\"\", re.I)\n_ROOT_CSS_URL = re.compile(r\"\"\"\\burl\\(\\s*(['\"]?)/(?!/)([^'\")]*)\\1\\s*\\)\"\"\", re.I)\n_BODY = re.compile(r\"<body\\b[^>]*>\", re.I)\n_HEAD = re.compile(r\"<head\\b[^>]*>\", re.I)\n_HTML = re.compile(r\"<html\\b[^>]*>\", re.I)\n_ASSET = re.compile(\n    r\"\"\"<(link|script|img)\\b[^>]*\\b(?:src|href)\\s*=\\s*['\"]([^'\"]+)['\"]\"\"\", re.I)\n\n\ndef _relative(url):\n    \"\"\"A URL that needs a folder to be found from.\"\"\"\n    return not re.match(r\"^(?:[a-z][\\w+.-]*:)?//|^data:|^#|^[a-z][\\w+.-]*:\",\n                        url or \"\", re.I)\n\n\ndef _blocks(page):\n    \"\"\"(start, end) of every top-level <svg> \u2026 </svg> in document order.\"\"\"\n    found, depth, start = [], 0, None\n    for match in _TAG.finditer(page):\n        if match.group(1):\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif match.group(2).rstrip().endswith(\"/\"):\n            if depth == 0:\n                found.append((match.start(), match.end()))\n        else:\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:\n        found.append((start, len(page)))\n    return found\n\n\ndef run(ctx, html, svg=None, path=None):\n    from pathlib import Path\n\n    page = html or \"\"\n    if not page.strip():\n        raise ValueError(\"no HTML on the input\")\n\n    if svg:\n        blocks = _blocks(page)\n        which = int(ctx.params[\"which\"])\n        if not blocks:\n            raise ValueError(\"no inline <svg> in the page to replace\")\n        if which > len(blocks):\n            raise ValueError(f\"the page has {len(blocks)} <svg> block(s), \"\n                             f\"asked for #{which}\")\n        start, end = blocks[which - 1]\n        page = page[:start] + svg + page[end:]\n        ctx.log(f\"swapped in {len(svg):,} chars of artwork\")\n\n    base = Path(path).parent if path else None\n    if base is None:\n        # Only a problem if the page actually reaches outside itself \u2014 a\n        # self-contained page with its style and script inline needs nothing.\n        outside = [url for _tag, url in _ASSET.findall(page) if _relative(url)]\n        if outside:\n            ctx.log(\n                f\"WARNING: no page path, and this page loads {len(outside)} \"\n                f\"external file(s) \u2014 {', '.join(sorted(set(outside))[:3])}\"\n                f\"{' \u2026' if len(set(outside)) > 3 else ''}. None of them can be \"\n                f\"found from here, so the preview will render unstyled and \"\n                f\"nothing on it will respond. Set Path on the Source File node.\"\n            )\n    else:\n        if bool(ctx.params[\"fix_absolute_urls\"]):\n            repointed = 0\n\n            def repoint(url):\n                \"\"\"A '/assets/app.js' that exists under the page's folder.\"\"\"\n                candidate = (base / url.lstrip(\"/\")).resolve()\n                return candidate if candidate.is_file() else None\n\n            def attribute(match):\n                nonlocal repointed\n                name, quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'{name}={quote}{target.as_uri()}{quote}'\n\n            def css_url(match):\n                nonlocal repointed\n                quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'url({quote}{target.as_uri()}{quote})'\n\n            page = _ROOT_URL.sub(attribute, page)\n            page = _ROOT_CSS_URL.sub(css_url, page)\n            if repointed:\n                ctx.log(f\"repointed {repointed} root-absolute URL(s) at {base}\")\n\n        # Before everything, so it governs every relative URL on the page \u2014\n        # and only if the page has not set one of its own.\n        if not re.search(r\"<base\\b\", page, re.I):\n            tag = f'<base href=\"{base.as_uri()}/\">'\n            anchor = _HEAD.search(page) or _HTML.search(page)\n            page = ((page[:anchor.end()] + tag + page[anchor.end():])\n                    if anchor else tag + page)\n            ctx.log(f\"assets resolve against {base}\")\n\n    banner = (ctx.params[\"banner\"] or \"\").strip()\n    if banner:\n        colour = (ctx.params[\"banner_color\"] or \"#0ea5e9\").strip()\n        ribbon = (\n            f'<div style=\"position:fixed;top:10px;right:10px;z-index:99999;'\n            f'font:600 11px/1 ui-sans-serif,system-ui,sans-serif;'\n            f'letter-spacing:.08em;text-transform:uppercase;color:#fff;'\n            f'background:{colour};padding:7px 11px;border-radius:999px;'\n            f'box-shadow:0 2px 10px rgba(0,0,0,.35);pointer-events:none;\">'\n            f'{banner}</div>'\n        )\n        body = _BODY.search(page)\n        page = (page[:body.end()] + ribbon + page[body.end():]) if body else ribbon + page\n\n    return {\"html\": page}\n",
    "label": "Page \u00b7 retrofitted"
   },
