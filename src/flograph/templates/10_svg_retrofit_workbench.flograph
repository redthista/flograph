    "params": {
     "sample": "<svg id=\"plan\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 520 320\" width=\"520\" height=\"320\">\n  <rect id=\"rect1\" x=\"0\" y=\"0\" width=\"520\" height=\"320\" fill=\"#111827\"/>\n  <g id=\"g2\" data-name=\"Zone North\">\n    <rect id=\"rect3\" data-name=\"Lab\" x=\"44\" y=\"44\" width=\"160\" height=\"88\" rx=\"10\" fill=\"#2563eb\"/>\n    <text id=\"text4\" x=\"60\" y=\"94\" fill=\"#e2e8f0\" font-size=\"14\" font-family=\"sans-serif\">Lab</text>\n  </g>\n  <g id=\"g5\" data-name=\"Zone South\">\n    <rect id=\"rect6\" data-name=\"Office\" x=\"44\" y=\"190\" width=\"160\" height=\"88\" rx=\"10\" fill=\"#0891b2\"/>\n    <text id=\"text7\" x=\"60\" y=\"240\" fill=\"#e2e8f0\" font-size=\"14\" font-family=\"sans-serif\">Office</text>\n    <rect id=\"rect8\" data-name=\"Store\" x=\"228\" y=\"190\" width=\"120\" height=\"88\" rx=\"10\" fill=\"#8b5cf6\"/>\n    <text id=\"text9\" x=\"244\" y=\"240\" fill=\"#e2e8f0\" font-size=\"14\" font-family=\"sans-serif\">Store</text>\n    <rect id=\"rect10\" data-name=\"Server Room\" x=\"368\" y=\"190\" width=\"112\" height=\"88\" rx=\"10\" fill=\"#15803d\"/>\n    <text id=\"text11\" x=\"384\" y=\"240\" fill=\"#e2e8f0\" font-size=\"14\" font-family=\"sans-serif\">Servers</text>\n  </g>\n  <path id=\"path12\" d=\"M 120 136 L 120 164 L 424 164 L 424 192\"/>\n  <circle id=\"circle13\" data-name=\"Valve A\" cx=\"228\" cy=\"164\" r=\"9\" fill=\"#38bdf8\"/>\n  <circle id=\"circle14\" data-name=\"Valve B\" cx=\"356\" cy=\"164\" r=\"9\" fill=\"#38bdf8\"/>\n</svg>\n"
    },
    "code": "\"\"\"Source File\n\nReads the page or the artwork off disk. Leave Path blank and the node hands\non the Sample below instead, so the whole workflow runs the moment you open\nit \u2014 then point Path at your own file and everything downstream follows.\n\n`path` is passed on as well, because the preview needs a directory to\nresolve a page's stylesheets and scripts against.\n\"\"\"\nNODE = {\n    \"label\": \"Source File\",\n    \"category\": \"IO\",\n    \"inputs\": [],\n    \"outputs\": [(\"text\", \"string\"), (\"path\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"path\", \"type\": \"file_open\", \"label\": \"Path\", \"default\": \"\",\n     \"placeholder\": \"blank = use the sample below\"},\n    {\"name\": \"encoding\", \"type\": \"string\", \"label\": \"Encoding\",\n     \"default\": \"utf-8\"},\n    {\"name\": \"sample\", \"type\": \"text\", \"label\": \"Sample\",\n     \"default\": \"\", \"placeholder\": \"used only while Path is blank\"},\n]\n\n\ndef run(ctx):\n    from pathlib import Path\n\n    path = (ctx.params[\"path\"] or \"\").strip()\n    if not path:\n        sample = ctx.params[\"sample\"] or \"\"\n        if not sample.strip():\n            raise ValueError(\n                \"no Path set and the Sample is empty \u2014 choose a file, or \"\n                \"paste the markup into the Sample box\"\n            )\n        ctx.log(f\"no path set \u2014 using the sample ({len(sample):,} chars)\")\n        return {\"text\": sample, \"path\": \"\"}\n\n    file = Path(path).expanduser()\n    if not file.is_file():\n        raise FileNotFoundError(f\"no such file: {file}\")\n    text = file.read_text(encoding=(ctx.params[\"encoding\"] or \"utf-8\"),\n                          errors=\"replace\")\n    ctx.log(f\"read {len(text):,} chars from {file.name}\")\n    return {\"text\": text, \"path\": str(file.resolve())}\n",
    "label": "New SVG"
   },
   {
    "id": "svg_extract",
    "type": "flograph.scripting.python_script",
    "pos": [
     -1400,
     -1300
    ],
    "params": {},
    "code": "\"\"\"Extract SVG\n\nPulls the inline <svg>\u2026</svg> out of the page, so what gets compared is the\nartwork the popups are actually bound to \u2014 not a copy on disk that may have\ndrifted from it.\n\nIf the page links its artwork with <img> or <object> instead, skip this node\nand wire a second Source File node straight at the .svg.\n\nBlocks are counted by depth rather than taken as the text between the first\n<svg> and the first </svg>: an SVG may legally contain another, and stopping\nat the inner close would hand everything downstream a truncated fragment\nthat fails to parse a long way from the actual mistake.\n\"\"\"\nimport re\n\n# Attribute values can contain '>', so the tag scan steps over quoted runs\n# instead of taking everything up to the next angle bracket.\n_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n\n\ndef _blocks(page):\n    \"\"\"(start, end) of every top-level <svg> \u2026 </svg> in document order.\"\"\"\n    found, depth, start = [], 0, None\n    for match in _TAG.finditer(page):\n        if match.group(1):                                   # </svg>\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif match.group(2).rstrip().endswith(\"/\"):          # <svg \u2026/>\n            if depth == 0:\n                found.append((match.start(), match.end()))\n        else:\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:                                    # never closed\n        found.append((start, len(page)))\n    return found\n\n\nNODE = {\n    \"label\": \"Extract SVG\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"svg\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"which\", \"type\": \"int\", \"label\": \"Which <svg> (1-based)\",\n     \"default\": 1, \"min\": 1, \"max\": 50},\n]\n\n\ndef run(ctx, html):\n    page = html or \"\"\n    blocks = [page[a:b] for a, b in _blocks(page)]\n    if not blocks:\n        raise ValueError(\n            \"no inline <svg> found in the page \u2014 if the artwork is linked \"\n            \"with <img> or <object>, point a Source File node at the .svg \"\n            \"file and wire that in instead of this node\"\n        )\n    which = int(ctx.params[\"which\"])\n    if which > len(blocks):\n        raise ValueError(\n            f\"the page has {len(blocks)} inline <svg> block(s), asked for #{which}\"\n        )\n    block = blocks[which - 1]\n    ctx.log(f\"extracted <svg> #{which} of {len(blocks)} \u2014 {len(block):,} chars\")\n    return {\"svg\": block}\n",
    "label": "Old SVG (out of the page)"
   },
   {
    "id": "svg_hooks",
    "type": "flograph.scripting.python_script",
    "pos": [
     -1400,
     -1120
    ],
    "params": {},
    "code": "\"\"\"HTML Hooks\n\nEvery id and class the page reaches into the artwork by \u2014 from script,\nstylesheet, and markup \u2014 so the question stops being \"what changed in the\nSVG\" (hundreds of rows) and becomes \"which of the handful of ids my popups\ndepend on no longer exist\".\n\nReferences found *inside* the inline <svg> are reported as `internal`: a\ngradient's own `url(#grad)`, a <use href=\"#sym\">. Those are the artwork's\nprivate plumbing, they come and go with it, and the retrofit rewrites them\nitself \u2014 they are not the page's grip on the drawing.\n\"\"\"\nimport re\n\nNODE = {\n    \"label\": \"HTML Hooks\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"hooks\", \"dataframe\")],\n}\nPARAMS = [\n    {\"name\": \"include_classes\", \"type\": \"bool\",\n     \"label\": \"Also track class hooks\", \"default\": True},\n]\n\n# (pattern, kind, which group holds the reference, is it a raw CSS selector)\n_PATTERNS = [\n    (r\"getElementById\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", False),\n    (r\"\\.id\\s*===?\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", False),\n    (r\"getElementsByClassName\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script-class\", False),\n    (r\"querySelector(?:All)?\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", True),\n    (r\"\\$\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\\s*\\)\", \"script\", True),\n    (r\"(?:xlink:)?href\\s*=\\s*['\\\"](#[\\w:.-]+)['\\\"]\", \"markup\", True),\n    (r\"\\b(?:data-target|aria-controls|data-for|for)\\s*=\\s*['\\\"](#?[\\w:.-]+)['\\\"]\",\n     \"markup\", True),\n    (r\"url\\(\\s*['\\\"]?(#[\\w:.-]+)['\\\"]?\\s*\\)\", \"style\", True),\n]\n\n# Stops at ':' so a stylesheet's `.room:hover` is a hook on `room`, and at\n# '[' so `#plan[data-x]` is a hook on `plan`.\n_SELECTOR = re.compile(r\"[#.]([A-Za-z_][\\w-]*)\")\n_STYLE_BLOCK = re.compile(r\"<style\\b[^>]*>(.*?)</style\\s*>\", re.S | re.I)\n# Depth-counted: a nested <svg> would otherwise close the range early and\n# leave the artwork's own plumbing looking like the page reaching into it.\n_SVG_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n\n\ndef _svg_ranges(page):\n    found, depth, start = [], 0, None\n    for match in _SVG_TAG.finditer(page):\n        if match.group(1):\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif not match.group(2).rstrip().endswith(\"/\"):\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:\n        found.append((start, len(page)))\n    return found\n\n\ndef _refs(text, is_selector, kind):\n    \"\"\"The (ref, kind) pairs one captured group contributes.\"\"\"\n    if not is_selector:\n        return [(text, \"id\" if not kind.endswith(\"-class\") else \"class\")]\n    out = []\n    for token in _SELECTOR.finditer(text):\n        out.append((token.group(1),\n                    \"class\" if token.group(0)[0] == \".\" else \"id\"))\n    return out\n\n\ndef run(ctx, html):\n    import pandas as pd\n\n    page = html or \"\"\n    include_classes = bool(ctx.params[\"include_classes\"])\n    inside = _svg_ranges(page)\n\n    def line_of(position):\n        return page.count(\"\\n\", 0, position) + 1\n\n    def internal(position):\n        return any(a <= position < b for a, b in inside)\n\n    seen = {}\n\n    def record(ref, target, where, position):\n        ref = ref.strip().lstrip(\"#\")\n        if not ref or (target == \"class\" and not include_classes):\n            return\n        key = (ref, target, where)\n        entry = seen.get(key)\n        if entry is None:\n            line = line_of(position)\n            snippet = page[max(0, position - 30):position + 50]\n            snippet = re.sub(r\"\\s+\", \" \", snippet).strip()\n            seen[key] = {\"ref\": ref, \"target\": target, \"where\": where,\n                         \"refs\": 1, \"line\": line, \"snippet\": snippet}\n        else:\n            entry[\"refs\"] += 1\n\n    for pattern, kind, is_selector in _PATTERNS:\n        for match in re.finditer(pattern, page, re.I):\n            captured = match.group(1)\n            where = \"internal\" if internal(match.start()) else kind.split(\"-\")[0]\n            for ref, target in _refs(captured, is_selector, kind):\n                record(ref, target, where, match.start())\n\n    # Stylesheet selectors are their own pass: a rule is #id { \u2026 }, with no\n    # surrounding call or attribute to anchor a pattern to.\n    for block in _STYLE_BLOCK.finditer(page):\n        body = re.sub(r\"/\\*.*?\\*/\", \" \", block.group(1), flags=re.S)\n        for rule in re.finditer(r\"([^{}]+)\\{\", body):\n            offset = block.start(1) + rule.start(1)\n            where = \"internal\" if internal(offset) else \"style\"\n            for token in _SELECTOR.finditer(rule.group(1)):\n                record(token.group(1),\n                       \"class\" if token.group(0)[0] == \".\" else \"id\",\n                       where, offset)\n\n    frame = pd.DataFrame(list(seen.values()), columns=[\n        \"ref\", \"target\", \"where\", \"refs\", \"line\", \"snippet\"])\n    if not frame.empty:\n        frame = (frame.sort_values([\"where\", \"target\", \"ref\"])\n                      .reset_index(drop=True))\n    external = int((frame[\"where\"] != \"internal\").sum()) if not frame.empty else 0\n    ctx.log(f\"{len(frame)} distinct hooks \u00b7 {external} reaching in from the page\")\n    return {\"hooks\": frame}\n",
    "label": "HTML Hooks"
   },
