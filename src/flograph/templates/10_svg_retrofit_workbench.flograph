 raise ValueError(\"no HTML on the input\")\n\n    if svg:\n        blocks = _blocks(page)\n        which = int(ctx.params[\"which\"])\n        if not blocks:\n            raise ValueError(\"no inline <svg> in the page to replace\")\n        if which > len(blocks):\n            raise ValueError(f\"the page has {len(blocks)} <svg> block(s), \"\n                             f\"asked for #{which}\")\n        start, end = blocks[which - 1]\n        page = page[:start] + svg + page[end:]\n        ctx.log(f\"swapped in {len(svg):,} chars of artwork\")\n\n    base = Path(path).parent if path else None\n    if base is None:\n        # Only a problem if the page actually reaches outside itself \u2014 a\n        # self-contained page with its style and script inline needs nothing.\n        outside = [url for _tag, url in _ASSET.findall(page) if _relative(url)]\n        if outside:\n            ctx.log(\n                f\"WARNING: no page path, and this page loads {len(outside)} \"\n                f\"external file(s) \u2014 {', '.join(sorted(set(outside))[:3])}\"\n                f\"{' \u2026' if len(set(outside)) > 3 else ''}. None of them can be \"\n                f\"found from here, so the preview will render unstyled and \"\n                f\"nothing on it will respond. Set Path on the Source File node.\"\n            )\n    else:\n        if bool(ctx.params[\"fix_absolute_urls\"]):\n            repointed = 0\n\n            def repoint(url):\n                \"\"\"A '/assets/app.js' that exists under the page's folder.\"\"\"\n                candidate = (base / url.lstrip(\"/\")).resolve()\n                return candidate if candidate.is_file() else None\n\n            def attribute(match):\n                nonlocal repointed\n                name, quote, rest = match.groups()\n                target = repoint(rest)\n                if target is None:\n                    return match.group(0)\n                repointed += 1\n                return f'{name}={quote}{ta