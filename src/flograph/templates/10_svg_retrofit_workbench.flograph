     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "Original page"
   },
   {
    "id": "svg_prev_raw",
    "type": "flograph.scripting.python_script",
    "pos": [
     760,
     -520
    ],
    "params": {
     "width": 620,
     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "Straight swap \u2014 hooks broken"
   },
   {
    "id": "svg_prev_fixed",
    "type": "flograph.scripting.python_script",
    "pos": [
     760,
     20
    ],
    "params": {
     "width": 620,
     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "After the retrofit"
   },
   {
    "id": "svg_report",
    "type": "flograph.scripting.python_script",
    "pos": [
     760,
     -1700
    ],
    "params": {
     "width": 660,
     "height": 560
    },
    "code": "\"\"\"Retrofit Report\n\nThe verdict, as a page: how many of the page's hooks survive the new export,\nwhich ones can be handed their old id back, and which ones have nothing left\nto hold.\n\nOrdered worst first on purpose. The interesting rows are the handful that\nbreak, and they are the ones a long table buries.\n\"\"\"\nfrom html import escape\n\nNODE = {\n    \"label\": \"Retrofit Report\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"impact\", \"dataframe\"), (\"matches\", \"dataframe\"),\n               (\"applied\", \"dataframe\", {\"optional\": True})],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"title\", \"type\": \"string\", \"label\": \"Title\",\n     \"default\": \"SVG retrofit report\"},\n    {\"name\": \"subtitle\", \"type\": \"string\", \"label\": \"Subtitle\", \"default\": \"\"},\n    {\"name\": \"show_safe\", \"type\": \"bool\", \"label\": \"List the safe hooks too\",\n     \"default\": True},\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 460, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n_VERDICT = {\n    \"BREAKS\": (\"#b91c1c\", \"#fee2e2\"),\n    \"review\": (\"#92400e\", \"#fef3c7\"),\n    \"auto-fix\": (\"#047857\", \"#d1fae5\"),\n    \"safe\": (\"#1d4ed8\", \"#dbeafe\"),\n    \"not in SVG\": (\"#475569\", \"#e2e8f0\"),\n}\n_STATUS = {\n    \"missing\": (\"#b91c1c\", \"#fee2e2\"),\n    \"unnamed\": (\"#9a3412\", \"#ffedd5\"),\n    \"renamed\": (\"#92400e\", \"#fef3c7\"),\n    \"added\": (\"#6d28d9\", \"#ede9fe\"),\n    \"kept\": (\"#1d4ed8\", \"#dbeafe\"),\n}\n# What the retrofit did to an element, and how to say so in a sentence.\n_ACTION = {\n    \"restored\": (\"#047857\", \"#d1fae5\"),\n    \"added\": (\"#047857\", \"#d1fae5\"),\n    \"classes\": (\"#1d4ed8\", \"#dbeafe\"),\n    \"manual\": (\"#92400e\", \"#fef3c7\"),\n    \"skipped\": (\"#475569\", \"#e2e8f0\"),\n}\n\n_CSS = \"\"\"\n:root { color-scheme: light dark; }\n* { box-sizing: border-box; }\nbody { margin:0; padding:20px; background:#f8fafc; color:#0f172a;\n       font:14px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }\nh1 { font-size:17px; margin:0; letter-spacing:-.01em; }\nh2 { font-size:12px; margin:26px 0 9px; text-transform:uppercase;\n     letter-spacing:.09em; color:#64748b; font-weight:600; }\np.sub { margin:4px 0 0; color:#64748b; font-size:13px; }\n/* flex-basis 0 rather than a width: five of these have to survive a card\n   narrow enough to sit next to three page previews. */\n.chips { display:flex; gap:8px; margin-top:16px; }\n.chip { flex:1 1 0; min-width:0; background:#fff; border:1px solid #e2e8f0;\n        border-radius:10px; padding:10px 11px; }\n.chip .n { font-size:22px; font-weight:650; letter-spacing:-.02em;\n           font-variant-numeric:tabular-nums; }\n.chip .k { font-size:11px; color:#64748b; margin-top:1px; }\n.wrap { overflow-x:auto; border:1px solid #e2e8f0; border-radius:10px;\n        background:#fff; }\ntable { border-collapse:collapse; width:100%; font-size:13px; }\nth { text-align:left; font-size:11px; letter-spacing:.05em; color:#64748b;\n     font-weight:600; text-transform:uppercase; padding:9px 12px;\n     border-bottom:1px solid #e2e8f0; white-space:nowrap; }\ntd { padding:8px 12px; border-bottom:1px solid #f1f5f9; vertical-align:top; }\ntr:last-child td { border-bottom:0; }\ncode { font:12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;\n       background:#f1f5f9; padding:1px 5px; border-radius:4px;\n       white-space:nowrap; }\n.pill { display:inline-block; font-size:11px; font-weight:650; padding:2px 8px;\n        border-radius:999px; white-space:nowrap; }\n.muted { color:#94a3b8; }\n.bar { height:6px; border-radius:999px; background:#e2e8f0; overflow:hidden;\n       min-width:70px; }\n.bar span { display:block; height:100%; }\n.empty { padding:16px; color:#64748b; background:#fff; border:1px dashed #cbd5e1;\n         border-radius:10px; font-size:13px; }\n@media (prefers-color-scheme: dark) {\n  body { background:#0b1220; color:#e2e8f0; }\n  .chip, .wrap, table { background:#111a2e; border-color:#1e293b; }\n  .chip { border-color:#1e293b; }\n  th { color:#94a3b8; border-bottom-color:#1e293b; }\n  td { border-bottom-color:#172033; }\n  code { background:#1e293b; color:#e2e8f0; }\n  .empty { background:#111a2e; border-color:#334155; color:#94a3b8; }\n  .bar { background:#1e293b; }\n}\n\"\"\"\n\n\ndef _pill(text, palette):\n    fg, bg = palette.get(text, (\"#475569\", \"#e2e8f0\"))\n    return f'<span class=\"pill\" style=\"color:{fg};background:{bg}\">{escape(str(text))}</span>'\n\n\ndef _confidence(value):\n    try:\n        value = float(value)\n    except (TypeError, ValueError):\n        return '<span class=\"muted\">\u2014</span>'\n    if value <= 0:\n        return '<span class=\"muted\">\u2014</span>'\n    hue = \"#047857\" if value >= 0.9 else \"#92400e\" if value >= 0.8 else \"#b91c1c\"\n    return _bar(value, hue)\n\n\ndef _bar(fraction, colour):\n    return (f'<div class=\"bar\"><span style=\"width:{max(fraction, 0.02) * 100:.0f}%;'\n            f'background:{colour}\"></span></div>')\n\n\ndef run(ctx, impact, matches, applied=None):\n    params = ctx.params\n    verdicts = (impact[\"verdict\"].value_counts().to_dict()\n                if not impact.empty else {})\n    statuses = (matches[\"status\"].value_counts().to_dict()\n                if not matches.empty else {})\n    breaks = verdicts.get(\"BREAKS\", 0)\n\n    out = [\"<style>\", _CSS, \"</style>\"]\n    out.append(f\"<h1>{escape(params['title'] or 'SVG retrofit report')}</h1>\")\n    subtitle = params[\"subtitle\"] or (\n        f\"{breaks} hook{'' if breaks == 1 else 's'} would break on the new \"\n        f\"artwork\" if breaks else \"every hook the page uses survives the new artwork\")\n    out.append(f'<p class=\"sub\">{escape(subtitle)}</p>')\n\n    out.append('<div class=\"chips\">')\n    for label, key, colour in [\n        (\"hooks in page\", None, \"#0f172a\"),\n        (\"safe\", \"safe\", \"#1d4ed8\"),\n        (\"auto-fix\", \"auto-fix\", \"#047857\"),\n        (\"review\", \"review\", \"#92400e\"),\n        (\"breaks\", \"BREAKS\", \"#b91c1c\"),\n    ]:\n        n = len(impact) if key is None else verdicts.get(key, 0)\n        out.append(f'<div class=\"chip\"><div class=\"n\" style=\"color:{colour}\">{n}</div>'\n                   f'<div class=\"k\">{label}</div></div>')\n    out.append(\"</div>\")\n\n    out.append(\"<h2>Hooks, worst first</h2>\")\n    rows = impact if params[\"show_safe\"] else impact[impact[\"verdict\"] != \"safe\"]\n    if rows.empty:\n        out.append('<div class=\"empty\">No hooks found \u2014 the page does not '\n                   'reach into the artwork by id.</div>')\n    else:\n        out.append('<div class=\"wrap\"><table><thead><tr>'\n                   \"<th>verdict</th><th>reference</th><th>used by</th>\"\n                   \"<th>new id</th><th>matched on</th><th>confidence</th>\"\n                   \"<th>note</th></tr></thead><tbody>\")\n        for row in rows.to_dict(\"records\"):\n            new_id = (f\"<code>{escape(str(row['new_id']))}</code>\"\n                      if row[\"new_id\"] else '<span class=\"muted\">\u2014</span>')\n            marker = \".\" if row[\"kind\"] == \"class\" else \"#\"\n            out.append(\n                \"<tr>\"\n                f\"<td>{_pill(row['verdict'], _VERDICT)}</td>\"\n                f\"<td><code>{marker}{escape(str(row['ref']))}</code></td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['used_by']))} \u00b7 \"\n                f\"{int(row['refs'])}\u00d7</td>\"\n                f\"<td>{new_id}</td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['match'] or '\u2014'))}</td>\"\n                f\"<td>{_confidence(row['confidence'])}</td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['note']))}</td>\"\n                \"</tr>\")\n        out.append(\"</tbody></table></div>\")\n\n    out.append(\"<h2>Every element, by outcome</h2>\")\n    total = sum(statuses.values()) or 1\n    out.append('<div class=\"wrap\"><table><tbody>')\n    for status in (\"missing\", \"unnamed\", \"renamed\", \"kept\", \"added\"):\n        n = statuses.get(status, 0)\n        out.append(\n            f\"<tr><td style=\\\"width:1%\\\">{_pill(status, _STATUS)}</td>\"\n            f'<td style=\"width:1%;font-variant-numeric:tabular-nums\">{n}</td>'\n            f'<td>{_bar(n / total, _STATUS[status][0]) if n else \"\"}</td></tr>')\n    out.append(\"</tbody></table></div>\")\n\n    if applied is not None and not applied.empty:\n        done = applied[applied[\"action\"].isin((\"restored\", \"added\", \"classes\"))]\n        out.append(f\"<h2>What the retrofit put back ({len(done)})</h2>\")\n        if done.empty:\n            out.append('<div class=\"empty\">Nothing was changed \u2014 either the '\n                       'confidence floor is too high, or the page uses none '\n                       'of the ids that changed.</div>')\n        else:\n            out.append('<div class=\"wrap\"><table><thead><tr><th>did</th>'\n                       \"<th>in the new file</th><th></th><th>given</th>\"\n                       \"<th>name</th><th>matched on</th></tr></thead><tbody>\")\n            for row in done.to_dict(\"records\"):\n                # An element that came back with no id of its own has nothing\n                # to put in the left column but what it is \u2014 which is the\n                # whole point of the row, so it says so rather than sitting\n                # blank.\n                was = str(row[\"new_id\"] or \"\")\n                tag = str(row.get(\"new_tag\") or row.get(\"tag\") or \"element\")\n                source = (f\"<code>{escape(was)}</code>\" if was else\n                          f'<span class=\"muted\">a &lt;{escape(tag)}&gt; '\n                          f\"with no id</span>\")\n                given = [f\"<code>#{escape(str(row['old_id']))}</code>\"] \\\n                    if row[\"action\"] in (\"restored\", \"added\") else []\n                given += [f\"<code>.{escape(name)}</code>\"\n                          for name in str(row.get(\"classes\") or \"\").split()]\n                out.append(\n                    f\"<tr><td>{_pill(row['action'], _ACTION)}</td>\"\n                    f\"<td>{source}</td>\"\n                    '<td class=\"muted\">\u2192</td>'\n                    f\"<td>{' '.join(given)}</td>\"\n                    f\"<td>{escape(str(row['name'] or ''))}</td>\"\n                    f\"<td class=\\\"muted\\\">{escape(str(row['match']))}</td></tr>\")\n            out.append(\"</tbody></table></div>\")\n\n        left = applied[applied[\"action\"] == \"manual\"]\n        if not left.empty:\n            out.append(f\"<h2>Left for a human ({len(left)})</h2>\")\n            out.append('<div class=\"wrap\"><table><thead><tr><th>id</th>'\n                       \"<th>why</th></tr></thead><tbody>\")\n            for row in left.to_dict(\"records\"):\n                out.append(\n                    f\"<tr><td><code>#{escape(str(row['old_id']))}</code></td>\"\n                    f\"<td class=\\\"muted\\\">{escape(str(row['why']))}</td></tr>\")\n            out.append(\"</tbody></table></div>\")\n\n    ctx.log(f\"{len(impact)} hooks \u00b7 {breaks} breaking\")\n    return {\"view\": \"\\n\".join(out)}\n",
    "label": "Retrofit Report"
   },
   {
    "id": "svg_table",
    "type": "flograph.viz.show_table",
    "pos": [
     1480,
     -1700
    ],
    "params": {
     "width": 640,
     "height": 440
    },
    "code": null,
    "label": "Element-by-element diff"
   },
   {
    "id": "svg_plan",
    "type": "flograph.scripting.python_script",
    "pos": [
     -580,
     -1300
    ],
    "params": {},
    "code": "\"\"\"Retrofit Plan\n\nOne row per element of the **new** artwork, with the old element it was\nmatched to alongside it \u2014 the left-to-right comparison the retrofit is about\nto act on, in the order the elements appear in the file.\n\nIt feeds the **Mapping** table, which is an ordinary editable grid. Add a\ncolumn of your own \u2014 the \uff0b button under the card \u2014 and type an id into it,\nand that element gets that id whatever the automatic match decided: the way\nto fix a pairing the flow got wrong, or to make one it never found. Type `-`\nto say \"leave this element alone\". Anything you have not typed in stays\nautomatic, so correcting one row costs you nothing on the others.\n\nThe row order is the document order of the new artwork, which does not move\nbetween runs \u2014 so the ids you key in stay beside the elements you keyed them\nagainst. Re-export the artwork and the elements move, and the mapping is\nworth reading again anyway.\n\n`ref` is the handle everything downstream uses: it is the element's position\nin the new element list, and it is what the retrofit finds the element by.\n\"\"\"\nNODE = {\n    \"label\": \"Retrofit Plan\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"new\", \"dataframe\"), (\"matches\", \"dataframe\"),\n               (\"hooks\", \"dataframe\", {\"optional\": True})],\n    \"outputs\": [(\"plan\", \"dataframe\")],\n}\nPARAMS = [\n    {\"name\": \"min_confidence\", \"type\": \"float\",\n     \"label\": \"Confidence floor (as the retrofit's)\", \"default\": 0.8,\n     \"min\": 0.0, \"max\": 1.0},\n    {\"name\": \"only_hooked\", \"type\": \"bool\",\n     \"label\": \"Only ids the page uses (as the retrofit's)\", \"default\": True},\n    {\"name\": \"everything\", \"type\": \"bool\",\n     \"label\": \"List every element, not just the ones you could act on\",\n     \"default\": False},\n]\n\n\ndef _ref(value):\n    \"\"\"`new_ref` as an int. Written out rather than `int(value or -1)`\n    because element 0 is a real element and `0 or -1` is -1 \u2014 a bug that\n    silently drops the first element of every file.\"\"\"\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return -1\n\n\ndef _describe(row):\n    \"\"\"`path \u00b7 cls-2`, or whatever the element has to be known by.\"\"\"\n    tag = str(row.get(\"tag\") or \"?\")\n    for key in (\"name\", \"text\", \"cls\"):\n        value = str(row.get(key) or \"\").strip()\n        if value:\n            return f\"{tag} \u00b7 {value}\"\n    return tag\n\n\ndef _at(row):\n    try:\n        x, y, w, h = (float(row[\"x\"]), float(row[\"y\"]),\n                      float(row[\"w\"]), float(row[\"h\"]))\n    except (KeyError, TypeError, ValueError):\n        return \"\"\n    return f\"{x:g},{y:g} {w:g}\u00d7{h:g}\" if (w or h) else f\"{x:g},{y:g}\"\n\n\ndef run(ctx, new, matches, hooks=None):\n    import pandas as pd\n\n    floor = float(ctx.params[\"min_confidence\"])\n    only_hooked = bool(ctx.params[\"only_hooked\"])\n    everything = bool(ctx.params[\"everything\"])\n\n    wanted = None\n    if only_hooked and hooks is not None and not hooks.empty:\n        wanted = {str(r[\"ref\"]) for r in hooks.to_dict(\"records\")\n                  if r[\"target\"] == \"id\" and r[\"where\"] != \"internal\"}\n\n    by_ref = {}\n    for row in matches.to_dict(\"records\"):\n        ref = _ref(row.get(\"new_ref\"))\n        if ref >= 0 and row.get(\"status\") != \"added\":\n            by_ref[ref] = row\n\n    rows = []\n    for element in new.to_dict(\"records\"):\n        ref = int(element.get(\"order\", len(rows)))\n        match = by_ref.get(ref)\n        id_now = str(element.get(\"id\") or \"\")\n        id_wanted = str(match[\"old_id\"]) if match else \"\"\n        confidence = float(match[\"confidence\"]) if match else 0.0\n\n        if match is None:\n            outcome = \"nothing to write\"\n        elif id_wanted == id_now:\n            outcome = \"already right\"\n        elif wanted is not None and id_wanted not in wanted:\n            outcome = \"the page never uses it\"\n        elif confidence < floor:\n            outcome = \"below the floor \u2014 check it\"\n        elif id_now:\n            outcome = \"rename it back\"\n        else:\n            outcome = \"write the id on\"\n\n        if not (everything or match is not None\n                or element.get(\"kind\") in (\"shape\", \"text\")):\n            continue\n        rows.append({\n            \"ref\": ref,\n            \"element\": _describe(element),\n            \"at\": _at(element),\n            \"id_now\": id_now,\n            \"id_wanted\": id_wanted,\n            \"was\": (f\"{match['tag']} #{match['old_id']}\"\n                    + (f\" \u00b7 {match['name']}\" if match and match[\"name\"] else \"\")\n                    if match else \"\"),\n            \"matched\": str(match[\"match\"]) if match else \"\",\n            \"confidence\": round(confidence, 2),\n            \"outcome\": outcome,\n        })\n\n    frame = pd.DataFrame(rows, columns=[\n        \"ref\", \"element\", \"at\", \"id_now\", \"id_wanted\", \"was\", \"matched\",\n        \"confidence\", \"outcome\"])\n    proposed = int((frame[\"id_wanted\"] != \"\").sum()) if not frame.empty else 0\n    ctx.log(f\"{len(frame)} element(s) listed \u00b7 {proposed} with an id proposed \"\n            f\"\u00b7 add a column and type into it to overrule any of them\")\n    return {\"plan\": frame}\n",
    "label": "Retrofit Plan"
   },
   {
    "id": "svg_map",
    "type": "flograph.io.table",
    "pos": [
     -580,
     -1160
    ],
    "params": {
     "width": 560,
     "height": 340
    },
    "code": null,
    "label": "Mapping \u2014 type into set_id"
   },
   {
    "id": "svg_apply",
    "type": "flograph.scripting.python_script",
    "pos": [
     -580,
     -740
    ],
    "params": {},
    "code": "\"\"\"Apply Mapping\n\nTakes the mapping table back off the grid and overrules the automatic match\nwith whatever you typed into it.\n\n**Add a column to the Mapping table** \u2014 the \uff0b button under the card, or\nright-click a header \u2014 and put an id in it, and the element on that row is\ngiven that id: matched or not, confident or not, whether or not the page\nappears to use it. Type `-` (or `none`) to say \"leave this element alone\"\nand any automatic pairing for it is dropped.\n\nThe column can be called anything. Any column the plan does not own is\nyours, and the first one you have typed in is the one that is read \u2014 which\nis also why a Table linked to an input keeps it: input columns are\nrefreshed from upstream every run, columns you add are not. Name one in\n**Your column** if you keep several and want a particular one to win.\n\nTwo rules keep the result coherent, both of them the same rule twice: an\nelement can carry one id, and an id can live on one element. Keying an id\nonto a row therefore takes it off whatever row had it before, rather than\nwriting it twice and leaving the page's `getElementById` to pick.\n\nNothing typed in means nothing changes \u2014 with no `set_id` column at all this\nnode passes the diff through untouched, which is how the flow behaves until\nyou start correcting it.\n\"\"\"\nNODE = {\n    \"label\": \"Apply Mapping\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"plan\", \"dataframe\"), (\"matches\", \"dataframe\"),\n               (\"new\", \"dataframe\"), (\"old\", \"dataframe\", {\"optional\": True})],\n    \"outputs\": [(\"matches\", \"dataframe\")],\n}\nPARAMS = [\n    {\"name\": \"column\", \"type\": \"string\", \"label\": \"Your column\",\n     \"default\": \"\",\n     \"placeholder\": \"blank = whichever column you added\"},\n]\n\n_CLEAR = {\"-\", \"--\", \"x\", \"no\", \"none\", \"skip\", \"leave\"}\n# The columns the plan itself owns; anything else on the table was put there\n# by whoever is reading it.\n_PLAN = (\"ref\", \"element\", \"at\", \"id_now\", \"id_wanted\", \"was\", \"matched\",\n         \"confidence\", \"outcome\")\n_STATUSES = (\"missing\", \"unnamed\", \"renamed\", \"added\", \"kept\")\n_SEVERITY = {status: n for n, status in enumerate(_STATUSES)}\n\n\ndef _ref(value):\n    \"\"\"`new_ref` as an int. Written out rather than `int(value or -1)`\n    because element 0 is a real element and `0 or -1` is -1 \u2014 a bug that\n    silently drops the first element of every file.\"\"\"\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return -1\n\n\ndef run(ctx, plan, matches, new, old=None):\n    import pandas as pd\n\n    def read(name):\n        \"\"\"What has been typed into one column, by ref.\"\"\"\n        found = {}\n        for row in plan.to_dict(\"records\"):\n            value = str(row.get(name) or \"\").strip()\n            if not value or value.lower() == \"nan\":\n                continue\n            try:\n                found[int(row[\"ref\"])] = value\n            except (KeyError, TypeError, ValueError):\n                ctx.log(f\"ignored {value!r}: the row it is on has no ref\")\n        return found\n\n    columns = list(getattr(plan, \"columns\", []))\n    named = (ctx.params[\"column\"] or \"\").strip()\n    mine = [c for c in columns if c not in _PLAN] if not named else [named]\n    if named and named not in columns:\n        ctx.log(f\"no `{named}` column on the mapping table \u2014 nothing overruled\")\n        return {\"matches\": matches}\n    if not mine:\n        ctx.log(\"nothing added to the mapping table \u2014 the automatic match \"\n                \"stands. Add a column to it and type an id into any row to \"\n                \"overrule that row.\")\n        return {\"matches\": matches}\n\n    typed, column = {}, mine[0]\n    for candidate in mine:\n        typed = read(candidate)\n        if typed:\n            column = candidate\n            break\n    if not typed:\n        ctx.log(f\"`{column}` is empty \u2014 the automatic match stands\")\n        return {\"matches\": matches}\n    ctx.log(f\"reading your `{column}` column: {len(typed)} row(s) filled in\")\n\n    elements = {int(r.get(\"order\", -1)): r for r in new.to_dict(\"records\")}\n    old_by_id = {}\n    if old is not None and not old.empty:\n        for row in old.to_dict(\"records\"):\n            if str(row.get(\"id\") or \"\"):\n                old_by_id[str(row[\"id\"])] = row\n\n    rows = matches.to_dict(\"records\")\n    added = cleared = 0\n    for ref, value in typed.items():\n        element = elements.get(ref)\n        if element is None:\n            ctx.log(f\"ignored {value!r}: no element has ref {ref}\")\n            continue\n        if value.lower() in _CLEAR:\n            before = len(rows)\n            rows = [r for r in rows if _ref(r.get(\"new_ref\")) != ref]\n            cleared += before - len(rows)\n            continue\n        # One id, one element: this pairing displaces both sides of any\n        # pairing it contradicts.\n        rows = [r for r in rows\n                if _ref(r.get(\"new_ref\")) != ref\n                and str(r.get(\"old_id\") or \"\") != value]\n        source = old_by_id.get(value, {})\n        id_now = str(element.get(\"id\") or \"\")\n        rows.append({\n            \"status\": (\"kept\" if id_now == value else\n                       \"unnamed\" if not id_now else \"renamed\"),\n            \"old_id\": value, \"new_id\": id_now,\n            \"name\": source.get(\"name\") or element.get(\"name\") or \"\",\n            \"tag\": source.get(\"tag\") or element.get(\"tag\"),\n            \"new_tag\": element.get(\"tag\"),\n            \"match\": \"manual\", \"confidence\": 1.0,\n            \"dx\": round(float(element.get(\"cx\", 0.0))\n                        - float(source.get(\"cx\", element.get(\"cx\", 0.0))), 2),\n            \"dy\": round(float(element.get(\"cy\", 0.0))\n                        - float(source.get(\"cy\", element.get(\"cy\", 0.0))), 2),\n            \"cls\": source.get(\"cls\") or \"\",\n            \"new_ref\": ref, \"manual\": True,\n        })\n        added += 1\n        if value not in old_by_id:\n            ctx.log(f\"{value!r} is not an id of the old artwork \u2014 writing it \"\n                    f\"on anyway, as asked\")\n\n    # Anything the manual pairings displaced is now unmatched on the old side,\n    # and saying so is the whole point of the report.\n    claimed = {str(r.get(\"old_id\") or \"\") for r in rows}\n    for row in matches.to_dict(\"records\"):\n        old_id = str(row.get(\"old_id\") or \"\")\n        if old_id and old_id not in claimed:\n            rows.append({**row, \"status\": \"missing\", \"new_id\": \"\",\n                         \"new_tag\": \"\", \"match\": \"\", \"confidence\": 0.0,\n                         \"dx\": 0.0, \"dy\": 0.0, \"new_ref\": -1, \"manual\": False})\n            claimed.add(old_id)\n\n    frame = pd.DataFrame(rows, columns=[\n        \"status\", \"old_id\", \"new_id\", \"name\", \"tag\", \"new_tag\", \"match\",\n        \"confidence\", \"dx\", \"dy\", \"cls\", \"new_ref\", \"manual\"])\n    if not frame.empty:\n        frame[\"manual\"] = frame[\"manual\"].fillna(False).astype(bool)\n        frame[\"_rank\"] = frame[\"status\"].map(_SEVERITY).fillna(9)\n        frame = (frame.sort_values([\"_rank\", \"confidence\", \"old_id\"],\n                                   ascending=[True, True, True])\n                      .drop(columns=\"_rank\").reset_index(drop=True))\n\n    ctx.log(f\"{added} pairing(s) set by hand \u00b7 {cleared} left alone on request\")\n    return {\"matches\": frame}\n",
    "label": "Apply Mapping"
   }
  ],
