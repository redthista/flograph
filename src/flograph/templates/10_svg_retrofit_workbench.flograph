   {
    "id": "svg_prev_orig",
    "type": "flograph.scripting.python_script",
    "pos": [
     60,
     -1060
    ],
    "params": {
     "width": 620,
     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "Original page"
   },
   {
    "id": "svg_prev_raw",
    "type": "flograph.scripting.python_script",
    "pos": [
     60,
     -520
    ],
    "params": {
     "width": 620,
     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "Straight swap \u2014 hooks broken"
   },
   {
    "id": "svg_prev_fixed",
    "type": "flograph.scripting.python_script",
    "pos": [
     60,
     20
    ],
    "params": {
     "width": 620,
     "height": 440
    },
    "code": "\"\"\"Page Preview\n\nRenders a page \u2014 the real one, scripts and all \u2014 inside the canvas card, so\n\"do the popups still work\" is a question you answer by clicking them rather\nthan by reading a table.\n\nTwo of these side by side, one fed the original page and one fed the\nretrofitted page, is the whole point of the workflow.\n\"\"\"\nNODE = {\n    \"label\": \"Page Preview\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 420, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n\ndef run(ctx, html):\n    ctx.log(f\"rendering {len(html or ''):,} chars\")\n    return {\"view\": html or \"<p>nothing to show</p>\"}\n",
    "label": "After the retrofit"
   },
   {
    "id": "svg_report",
    "type": "flograph.scripting.python_script",
    "pos": [
     60,
     -1700
    ],
    "params": {
     "width": 660,
     "height": 560
    },
    "code": "\"\"\"Retrofit Report\n\nThe verdict, as a page: how many of the page's hooks survive the new export,\nwhich ones can be handed their old id back, and which ones have nothing left\nto hold.\n\nOrdered worst first on purpose. The interesting rows are the handful that\nbreak, and they are the ones a long table buries.\n\"\"\"\nfrom html import escape\n\nNODE = {\n    \"label\": \"Retrofit Report\",\n    \"category\": \"Viz\",\n    \"card\": \"webview\",\n    \"inputs\": [(\"impact\", \"dataframe\"), (\"matches\", \"dataframe\"),\n               (\"applied\", \"dataframe\", {\"optional\": True})],\n    \"outputs\": [(\"view\", \"object\")],\n}\nPARAMS = [\n    {\"name\": \"title\", \"type\": \"string\", \"label\": \"Title\",\n     \"default\": \"SVG retrofit report\"},\n    {\"name\": \"subtitle\", \"type\": \"string\", \"label\": \"Subtitle\", \"default\": \"\"},\n    {\"name\": \"show_safe\", \"type\": \"bool\", \"label\": \"List the safe hooks too\",\n     \"default\": True},\n    {\"name\": \"width\", \"type\": \"int\", \"label\": \"Width\",\n     \"default\": 560, \"min\": 260, \"max\": 1600},\n    {\"name\": \"height\", \"type\": \"int\", \"label\": \"Height\",\n     \"default\": 460, \"min\": 200, \"max\": 2000},\n    {\"name\": \"scale\", \"type\": \"int\", \"label\": \"Scale %\",\n     \"default\": 100, \"min\": 25, \"max\": 400},\n]\n\n_VERDICT = {\n    \"BREAKS\": (\"#b91c1c\", \"#fee2e2\"),\n    \"review\": (\"#92400e\", \"#fef3c7\"),\n    \"auto-fix\": (\"#047857\", \"#d1fae5\"),\n    \"safe\": (\"#1d4ed8\", \"#dbeafe\"),\n    \"not in SVG\": (\"#475569\", \"#e2e8f0\"),\n}\n_STATUS = {\n    \"missing\": (\"#b91c1c\", \"#fee2e2\"),\n    \"renamed\": (\"#92400e\", \"#fef3c7\"),\n    \"added\": (\"#6d28d9\", \"#ede9fe\"),\n    \"kept\": (\"#1d4ed8\", \"#dbeafe\"),\n}\n\n_CSS = \"\"\"\n:root { color-scheme: light dark; }\n* { box-sizing: border-box; }\nbody { margin:0; padding:20px; background:#f8fafc; color:#0f172a;\n       font:14px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }\nh1 { font-size:17px; margin:0; letter-spacing:-.01em; }\nh2 { font-size:12px; margin:26px 0 9px; text-transform:uppercase;\n     letter-spacing:.09em; color:#64748b; font-weight:600; }\np.sub { margin:4px 0 0; color:#64748b; font-size:13px; }\n/* flex-basis 0 rather than a width: five of these have to survive a card\n   narrow enough to sit next to three page previews. */\n.chips { display:flex; gap:8px; margin-top:16px; }\n.chip { flex:1 1 0; min-width:0; background:#fff; border:1px solid #e2e8f0;\n        border-radius:10px; padding:10px 11px; }\n.chip .n { font-size:22px; font-weight:650; letter-spacing:-.02em;\n           font-variant-numeric:tabular-nums; }\n.chip .k { font-size:11px; color:#64748b; margin-top:1px; }\n.wrap { overflow-x:auto; border:1px solid #e2e8f0; border-radius:10px;\n        background:#fff; }\ntable { border-collapse:collapse; width:100%; font-size:13px; }\nth { text-align:left; font-size:11px; letter-spacing:.05em; color:#64748b;\n     font-weight:600; text-transform:uppercase; padding:9px 12px;\n     border-bottom:1px solid #e2e8f0; white-space:nowrap; }\ntd { padding:8px 12px; border-bottom:1px solid #f1f5f9; vertical-align:top; }\ntr:last-child td { border-bottom:0; }\ncode { font:12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;\n       background:#f1f5f9; padding:1px 5px; border-radius:4px;\n       white-space:nowrap; }\n.pill { display:inline-block; font-size:11px; font-weight:650; padding:2px 8px;\n        border-radius:999px; white-space:nowrap; }\n.muted { color:#94a3b8; }\n.bar { height:6px; border-radius:999px; background:#e2e8f0; overflow:hidden;\n       min-width:70px; }\n.bar span { display:block; height:100%; }\n.empty { padding:16px; color:#64748b; background:#fff; border:1px dashed #cbd5e1;\n         border-radius:10px; font-size:13px; }\n@media (prefers-color-scheme: dark) {\n  body { background:#0b1220; color:#e2e8f0; }\n  .chip, .wrap, table { background:#111a2e; border-color:#1e293b; }\n  .chip { border-color:#1e293b; }\n  th { color:#94a3b8; border-bottom-color:#1e293b; }\n  td { border-bottom-color:#172033; }\n  code { background:#1e293b; color:#e2e8f0; }\n  .empty { background:#111a2e; border-color:#334155; color:#94a3b8; }\n  .bar { background:#1e293b; }\n}\n\"\"\"\n\n\ndef _pill(text, palette):\n    fg, bg = palette.get(text, (\"#475569\", \"#e2e8f0\"))\n    return f'<span class=\"pill\" style=\"color:{fg};background:{bg}\">{escape(str(text))}</span>'\n\n\ndef _confidence(value):\n    try:\n        value = float(value)\n    except (TypeError, ValueError):\n        return '<span class=\"muted\">\u2014</span>'\n    if value <= 0:\n        return '<span class=\"muted\">\u2014</span>'\n    hue = \"#047857\" if value >= 0.9 else \"#92400e\" if value >= 0.8 else \"#b91c1c\"\n    return _bar(value, hue)\n\n\ndef _bar(fraction, colour):\n    return (f'<div class=\"bar\"><span style=\"width:{max(fraction, 0.02) * 100:.0f}%;'\n            f'background:{colour}\"></span></div>')\n\n\ndef run(ctx, impact, matches, applied=None):\n    params = ctx.params\n    verdicts = (impact[\"verdict\"].value_counts().to_dict()\n                if not impact.empty else {})\n    statuses = (matches[\"status\"].value_counts().to_dict()\n                if not matches.empty else {})\n    breaks = verdicts.get(\"BREAKS\", 0)\n\n    out = [\"<style>\", _CSS, \"</style>\"]\n    out.append(f\"<h1>{escape(params['title'] or 'SVG retrofit report')}</h1>\")\n    subtitle = params[\"subtitle\"] or (\n        f\"{breaks} hook{'' if breaks == 1 else 's'} would break on the new \"\n        f\"artwork\" if breaks else \"every hook the page uses survives the new artwork\")\n    out.append(f'<p class=\"sub\">{escape(subtitle)}</p>')\n\n    out.append('<div class=\"chips\">')\n    for label, key, colour in [\n        (\"hooks in page\", None, \"#0f172a\"),\n        (\"safe\", \"safe\", \"#1d4ed8\"),\n        (\"auto-fix\", \"auto-fix\", \"#047857\"),\n        (\"review\", \"review\", \"#92400e\"),\n        (\"breaks\", \"BREAKS\", \"#b91c1c\"),\n    ]:\n        n = len(impact) if key is None else verdicts.get(key, 0)\n        out.append(f'<div class=\"chip\"><div class=\"n\" style=\"color:{colour}\">{n}</div>'\n                   f'<div class=\"k\">{label}</div></div>')\n    out.append(\"</div>\")\n\n    out.append(\"<h2>Hooks, worst first</h2>\")\n    rows = impact if params[\"show_safe\"] else impact[impact[\"verdict\"] != \"safe\"]\n    if rows.empty:\n        out.append('<div class=\"empty\">No hooks found \u2014 the page does not '\n                   'reach into the artwork by id.</div>')\n    else:\n        out.append('<div class=\"wrap\"><table><thead><tr>'\n                   \"<th>verdict</th><th>reference</th><th>used by</th>\"\n                   \"<th>new id</th><th>matched on</th><th>confidence</th>\"\n                   \"<th>note</th></tr></thead><tbody>\")\n        for row in rows.to_dict(\"records\"):\n            new_id = (f\"<code>{escape(str(row['new_id']))}</code>\"\n                      if row[\"new_id\"] else '<span class=\"muted\">\u2014</span>')\n            marker = \".\" if row[\"kind\"] == \"class\" else \"#\"\n            out.append(\n                \"<tr>\"\n                f\"<td>{_pill(row['verdict'], _VERDICT)}</td>\"\n                f\"<td><code>{marker}{escape(str(row['ref']))}</code></td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['used_by']))} \u00b7 \"\n                f\"{int(row['refs'])}\u00d7</td>\"\n                f\"<td>{new_id}</td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['match'] or '\u2014'))}</td>\"\n                f\"<td>{_confidence(row['confidence'])}</td>\"\n                f\"<td class=\\\"muted\\\">{escape(str(row['note']))}</td>\"\n                \"</tr>\")\n        out.append(\"</tbody></table></div>\")\n\n    out.append(\"<h2>Every element, by outcome</h2>\")\n    total = sum(statuses.values()) or 1\n    out.append('<div class=\"wrap\"><table><tbody>')\n    for status in (\"missing\", \"renamed\", \"kept\", \"added\"):\n        n = statuses.get(status, 0)\n        out.append(\n            f\"<tr><td style=\\\"width:1%\\\">{_pill(status, _STATUS)}</td>\"\n            f'<td style=\"width:1%;font-variant-numeric:tabular-nums\">{n}</td>'\n            f'<td>{_bar(n / total, _STATUS[status][0]) if n else \"\"}</td></tr>')\n    out.append(\"</tbody></table></div>\")\n\n    if applied is not None and not applied.empty:\n        restored = applied[applied[\"action\"] == \"restored\"]\n        out.append(f\"<h2>Ids handed back ({len(restored)})</h2>\")\n        if restored.empty:\n            out.append('<div class=\"empty\">Nothing was renamed \u2014 either the '\n                       'confidence floor is too high, or the page uses none '\n                       'of the ids that changed.</div>')\n        else:\n            out.append('<div class=\"wrap\"><table><thead><tr><th>in the new file</th>'\n                       \"<th></th><th>restored to</th><th>name</th>\"\n                       \"<th>matched on</th></tr></thead><tbody>\")\n            for row in restored.to_dict(\"records\"):\n                out.append(\n                    f\"<tr><td><code>{escape(str(row['new_id']))}</code></td>\"\n                    '<td class=\"muted\">\u2192</td>'\n                    f\"<td><code>{escape(str(row['old_id']))}</code></td>\"\n                    f\"<td>{escape(str(row['name'] or ''))}</td>\"\n                    f\"<td class=\\\"muted\\\">{escape(str(row['match']))}</td></tr>\")\n            out.append(\"</tbody></table></div>\")\n\n    ctx.log(f\"{len(impact)} hooks \u00b7 {breaks} breaking\")\n    return {\"view\": \"\\n\".join(out)}\n",
    "label": "Retrofit Report"
   },
   {
