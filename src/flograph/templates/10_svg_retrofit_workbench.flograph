    "params": {
     "sample": "<svg id=\"Layer_1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 520 320\" width=\"520\" height=\"320\">\n  <!-- Re-exported from the design tool: layer names survived, ids did not,\n       and every drawn box came back as a <path>. -->\n  <defs>\n    <style>\n      .cls-1 { fill: #111827; }\n      .cls-2 { fill: #2563eb; }\n      .cls-3 { fill: #0891b2; }\n      .cls-4 { fill: #8b5cf6; }\n      .cls-5 { fill: #15803d; }\n      .cls-6 { fill: #e2e8f0; font-family: sans-serif; font-size: 14px; }\n      .cls-7 { fill: #38bdf8; }\n    </style>\n  </defs>\n  <rect class=\"cls-1\" width=\"520\" height=\"320\"/>\n  <g data-name=\"Zone North\">\n    <path class=\"cls-2\" d=\"M50,48h140a10,10 0 0 1 10,10v68a10,10 0 0 1 -10,10h-140a10,10 0 0 1 -10,-10v-68a10,10 0 0 1 10,-10Z\"/>\n    <text class=\"cls-6\" transform=\"translate(56 98)\">Lab</text>\n    <path class=\"cls-5\" data-name=\"Server Room\" d=\"M250,48h220a10,10 0 0 1 10,10v68a10,10 0 0 1 -10,10h-220a10,10 0 0 1 -10,-10v-68a10,10 0 0 1 10,-10Z\"/>\n    <text class=\"cls-6\" transform=\"translate(256 98)\">Servers</text>\n  </g>\n  <g data-name=\"Zone South\">\n    <path class=\"cls-3\" d=\"M50,192h140a10,10 0 0 1 10,10v68a10,10 0 0 1 -10,10h-140a10,10 0 0 1 -10,-10v-68a10,10 0 0 1 10,-10Z\"/>\n    <text class=\"cls-6\" transform=\"translate(56 242)\">Office</text>\n    <path class=\"cls-4\" d=\"M234,192h100a10,10 0 0 1 10,10v68a10,10 0 0 1 -10,10h-100a10,10 0 0 1 -10,-10v-68a10,10 0 0 1 10,-10Z\"/>\n    <text class=\"cls-6\" transform=\"translate(240 242)\">Store</text>\n  </g>\n  <path d=\"M120,136v28h304v28\"/>\n  <circle class=\"cls-7\" data-name=\"Valve A\" cx=\"224\" cy=\"164\" r=\"9\"/>\n  <circle class=\"cls-7\" data-name=\"Valve B\" cx=\"352\" cy=\"164\" r=\"9\"/>\n  <circle class=\"cls-7\" data-name=\"Capped main\" cx=\"424\" cy=\"192\" r=\"6\"/>\n</svg>\n"
    },
    "code": "\"\"\"Source File\n\nReads the page or the artwork off disk. Leave Path blank and the node hands\non the Sample below instead, so the whole workflow runs the moment you open\nit \u2014 then point Path at your own file and everything downstream follows.\n\n`path` is passed on as well, because the preview needs a directory to\nresolve a page's stylesheets and scripts against.\n\"\"\"\nNODE = {\n    \"label\": \"Source File\",\n    \"category\": \"IO\",\n    \"inputs\": [],\n    \"outputs\": [(\"text\", \"string\"), (\"path\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"path\", \"type\": \"file_open\", \"label\": \"Path\", \"default\": \"\",\n     \"placeholder\": \"blank = use the sample below\"},\n    {\"name\": \"encoding\", \"type\": \"string\", \"label\": \"Encoding\",\n     \"default\": \"utf-8\"},\n    {\"name\": \"sample\", \"type\": \"text\", \"label\": \"Sample\",\n     \"default\": \"\", \"placeholder\": \"used only while Path is blank\"},\n]\n\n\ndef run(ctx):\n    from pathlib import Path\n\n    path = (ctx.params[\"path\"] or \"\").strip()\n    if not path:\n        sample = ctx.params[\"sample\"] or \"\"\n        if not sample.strip():\n            raise ValueError(\n                \"no Path set and the Sample is empty \u2014 choose a file, or \"\n                \"paste the markup into the Sample box\"\n            )\n        ctx.log(f\"no path set \u2014 using the sample ({len(sample):,} chars)\")\n        return {\"text\": sample, \"path\": \"\"}\n\n    file = Path(path).expanduser()\n    if not file.is_file():\n        raise FileNotFoundError(f\"no such file: {file}\")\n    text = file.read_text(encoding=(ctx.params[\"encoding\"] or \"utf-8\"),\n                          errors=\"replace\")\n    ctx.log(f\"read {len(text):,} chars from {file.name}\")\n    return {\"text\": text, \"path\": str(file.resolve())}\n",
    "label": "New SVG"
   },
   {
    "id": "svg_extract",
    "type": "flograph.scripting.python_script",
    "pos": [
     -1400,
     -1300
    ],
    "params": {},
    "code": "\"\"\"Extract SVG\n\nPulls the inline <svg>\u2026</svg> out of the page, so what gets compared is the\nartwork the popups are actually bound to \u2014 not a copy on disk that may have\ndrifted from it.\n\nIf the page links its artwork with <img> or <object> instead, skip this node\nand wire a second Source File node straight at the .svg.\n\nBlocks are counted by depth rather than taken as the text between the first\n<svg> and the first </svg>: an SVG may legally contain another, and stopping\nat the inner close would hand everything downstream a truncated fragment\nthat fails to parse a long way from the actual mistake.\n\"\"\"\nimport re\n\n# Attribute values can contain '>', so the tag scan steps over quoted runs\n# instead of taking everything up to the next angle bracket.\n_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n\n\ndef _blocks(page):\n    \"\"\"(start, end) of every top-level <svg> \u2026 </svg> in document order.\"\"\"\n    found, depth, start = [], 0, None\n    for match in _TAG.finditer(page):\n        if match.group(1):                                   # </svg>\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif match.group(2).rstrip().endswith(\"/\"):          # <svg \u2026/>\n            if depth == 0:\n                found.append((match.start(), match.end()))\n        else:\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:                                    # never closed\n        found.append((start, len(page)))\n    return found\n\n\nNODE = {\n    \"label\": \"Extract SVG\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\")],\n    \"outputs\": [(\"svg\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"which\", \"type\": \"int\", \"label\": \"Which <svg> (1-based)\",\n     \"default\": 1, \"min\": 1, \"max\": 50},\n]\n\n\ndef run(ctx, html):\n    page = html or \"\"\n    blocks = [page[a:b] for a, b in _blocks(page)]\n    if not blocks:\n        raise ValueError(\n            \"no inline <svg> found in the page \u2014 if the artwork is linked \"\n            \"with <img> or <object>, point a Source File node at the .svg \"\n            \"file and wire that in instead of this node\"\n        )\n    which = int(ctx.params[\"which\"])\n    if which > len(blocks):\n        raise ValueError(\n            f\"the page has {len(blocks)} inline <svg> block(s), asked for #{which}\"\n        )\n    block = blocks[which - 1]\n    ctx.log(f\"extracted <svg> #{which} of {len(blocks)} \u2014 {len(block):,} chars\")\n    return {\"svg\": block}\n",
    "label": "Old SVG (out of the page)"
   },
   {
    "id": "svg_hooks",
    "type": "flograph.scripting.python_script",
    "pos": [
     -1400,
     -1120
    ],
    "params": {},
    "code": "\"\"\"HTML Hooks\n\nEvery id and class the page reaches into the artwork by \u2014 from script,\nstylesheet, and markup \u2014 so the question stops being \"what changed in the\nSVG\" (hundreds of rows) and becomes \"which of the handful of ids my popups\ndepend on no longer exist\".\n\nReferences found *inside* the inline <svg> are reported as `internal`: a\ngradient's own `url(#grad)`, a <use href=\"#sym\">. Those are the artwork's\nprivate plumbing, they come and go with it, and the retrofit rewrites them\nitself \u2014 they are not the page's grip on the drawing.\n\n**Wire the old artwork's elements in** and one more pass runs, which is the\none that finds real pages. The patterns above only see an id where the page\nnames it in a way a machine can recognise \u2014 `getElementById(\"room-lab\")`, a\n`#room-lab` rule, an `href=\"#room-lab\"`. Plenty of pages never do any of\nthat: they bind one handler to the whole drawing, read `event.target.id`,\nand look the answer up in a table of their own \u2014\n\n    var rooms = {\"G1.1\": {title: \"Lab\", body: \u2026}, \"G1.2\": {\u2026}};\n\nwhere the ids the popups depend on are nothing but quoted strings. Knowing\nwhat the artwork actually contains settles it: a string that is exactly the\nid of an element in the drawing is that element being referred to, whatever\nthe surrounding code does with it. Without this the page looks as if it\ntouches three ids out of a hundred and seventy, and a retrofit told to\nrestore only what the page uses restores nothing.\n\nIds reached from a **separate .js file** cannot be seen from the page at\nall \u2014 those are counted and named in the log so the silence is visible\nrather than mistaken for an answer.\n\"\"\"\nimport re\n\nNODE = {\n    \"label\": \"HTML Hooks\",\n    \"category\": \"Transform\",\n    \"inputs\": [(\"html\", \"string\"),\n               (\"elements\", \"dataframe\", {\"optional\": True})],\n    \"outputs\": [(\"hooks\", \"dataframe\")],\n}\nPARAMS = [\n    {\"name\": \"include_classes\", \"type\": \"bool\",\n     \"label\": \"Also track class hooks\", \"default\": True},\n    {\"name\": \"by_name\", \"type\": \"bool\",\n     \"label\": \"Count an id the page quotes anywhere as a hook\", \"default\": True},\n]\n\n# (pattern, kind, which group holds the reference, is it a raw CSS selector)\n_PATTERNS = [\n    (r\"getElementById\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", False),\n    (r\"\\.id\\s*===?\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", False),\n    (r\"getElementsByClassName\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script-class\", False),\n    (r\"querySelector(?:All)?\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", \"script\", True),\n    (r\"\\$\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\\s*\\)\", \"script\", True),\n    (r\"(?:xlink:)?href\\s*=\\s*['\\\"](#[\\w:.-]+)['\\\"]\", \"markup\", True),\n    (r\"\\b(?:data-target|aria-controls|data-for|for)\\s*=\\s*['\\\"](#?[\\w:.-]+)['\\\"]\",\n     \"markup\", True),\n    (r\"url\\(\\s*['\\\"]?(#[\\w:.-]+)['\\\"]?\\s*\\)\", \"style\", True),\n]\n\n# Stops at ':' so a stylesheet's `.room:hover` is a hook on `room`, and at\n# '[' so `#plan[data-x]` is a hook on `plan`.\n_SELECTOR = re.compile(r\"[#.]([A-Za-z_][\\w-]*)\")\n_STYLE_BLOCK = re.compile(r\"<style\\b[^>]*>(.*?)</style\\s*>\", re.S | re.I)\n_SCRIPT_BLOCK = re.compile(r\"<script\\b[^>]*>(.*?)</script\\s*>\", re.S | re.I)\n_EXTERNAL = re.compile(r\"<script\\b[^>]*?\\bsrc\\s*=\\s*['\\\"]([^'\\\"]+)['\\\"]\", re.I)\n# Quoted anything: a JS string, an object key, an HTML attribute value. Kept\n# to one line and a sane length so a minified blob or a base64 data: URI is\n# not scanned character by character for no reason.\n_LITERAL = re.compile(r\"'([^'\\n]{1,120})'|\\\"([^\\\"\\n]{1,120})\\\"|`([^`\\n]{1,120})`\")\n# Depth-counted: a nested <svg> would otherwise close the range early and\n# leave the artwork's own plumbing looking like the page reaching into it.\n_SVG_TAG = re.compile(r\"<(/?)svg\\b((?:\\\"[^\\\"]*\\\"|'[^']*'|[^>])*)>\", re.I | re.S)\n\n\ndef _svg_ranges(page):\n    found, depth, start = [], 0, None\n    for match in _SVG_TAG.finditer(page):\n        if match.group(1):\n            depth = max(depth - 1, 0)\n            if depth == 0 and start is not None:\n                found.append((start, match.end()))\n                start = None\n        elif not match.group(2).rstrip().endswith(\"/\"):\n            if depth == 0:\n                start = match.start()\n            depth += 1\n    if start is not None:\n        found.append((start, len(page)))\n    return found\n\n\ndef _refs(text, is_selector, kind):\n    \"\"\"The (ref, kind) pairs one captured group contributes.\"\"\"\n    if not is_selector:\n        return [(text, \"id\" if not kind.endswith(\"-class\") else \"class\")]\n    out = []\n    for token in _SELECTOR.finditer(text):\n        out.append((token.group(1),\n                    \"class\" if token.group(0)[0] == \".\" else \"id\"))\n    return out\n\n\ndef run(ctx, html, elements=None):\n    import pandas as pd\n\n    page = html or \"\"\n    include_classes = bool(ctx.params[\"include_classes\"])\n    inside = _svg_ranges(page)\n\n    def line_of(position):\n        return page.count(\"\\n\", 0, position) + 1\n\n    def internal(position):\n        return any(a <= position < b for a, b in inside)\n\n    seen = {}\n\n    def record(ref, target, where, position):\n        ref = ref.strip().lstrip(\"#\")\n        if not ref or (target == \"class\" and not include_classes):\n            return\n        key = (ref, target, where)\n        entry = seen.get(key)\n        if entry is None:\n            line = line_of(position)\n            snippet = page[max(0, position - 30):position + 50]\n            snippet = re.sub(r\"\\s+\", \" \", snippet).strip()\n            seen[key] = {\"ref\": ref, \"target\": target, \"where\": where,\n                         \"refs\": 1, \"line\": line, \"snippet\": snippet}\n        else:\n            entry[\"refs\"] += 1\n\n    for pattern, kind, is_selector in _PATTERNS:\n        for match in re.finditer(pattern, page, re.I):\n            captured = match.group(1)\n            where = \"internal\" if internal(match.start()) else kind.split(\"-\")[0]\n            for ref, target in _refs(captured, is_selector, kind):\n                record(ref, target, where, match.start())\n\n    # Stylesheet selectors are their own pass: a rule is #id { \u2026 }, with no\n    # surrounding call or attribute to anchor a pattern to.\n    for block in _STYLE_BLOCK.finditer(page):\n        body = re.sub(r\"/\\*.*?\\*/\", \" \", block.group(1), flags=re.S)\n        for rule in re.finditer(r\"([^{}]+)\\{\", body):\n            offset = block.start(1) + rule.start(1)\n            where = \"internal\" if internal(offset) else \"style\"\n            for token in _SELECTOR.finditer(rule.group(1)):\n                record(token.group(1),\n                       \"class\" if token.group(0)[0] == \".\" else \"id\",\n                       where, offset)\n\n    # The pass that needs to know what the artwork contains: any id of the\n    # drawing that the page quotes, however it goes on to use it.\n    known = set()\n    if elements is not None and not elements.empty and \"id\" in elements:\n        known = {str(value).strip() for value in elements[\"id\"].tolist()\n                 if str(value or \"\").strip()}\n    if known and bool(ctx.params[\"by_name\"]):\n        blocks = [(m.start(1), m.end(1)) for m in _SCRIPT_BLOCK.finditer(page)]\n        for match in _LITERAL.finditer(page):\n            if internal(match.start()):\n                continue\n            value = (match.group(1) or match.group(2) or match.group(3) or \"\")\n            # A lone id, or one written as a selector \u2014 not a whole selector,\n            # which the patterns above already read properly.\n            ref = value.strip().lstrip(\"#.\")\n            if len(ref) < 2 or ref not in known:\n                continue\n            record(ref, \"id\", \"script\" if any(a <= match.start() < b\n                                              for a, b in blocks) else \"markup\",\n                   match.start())\n\n    frame = pd.DataFrame(list(seen.values()), columns=[\n        \"ref\", \"target\", \"where\", \"refs\", \"line\", \"snippet\"])\n    if not frame.empty:\n        frame = (frame.sort_values([\"where\", \"target\", \"ref\"])\n                      .reset_index(drop=True))\n    external = int((frame[\"where\"] != \"internal\").sum()) if not frame.empty else 0\n    ctx.log(f\"{len(frame)} distinct hooks \u00b7 {external} reaching in from the page\")\n\n    if known:\n        reached = {r[\"ref\"] for r in seen.values()\n                   if r[\"target\"] == \"id\" and r[\"where\"] != \"internal\"}\n        ctx.log(f\"{len(reached & known)} of the {len(known)} ids in the old \"\n                f\"artwork are named by the page\")\n    elif elements is None:\n        ctx.log(\"wire the old artwork's elements in to also catch ids the page \"\n                \"only quotes as strings\")\n\n    loaded = [m.group(1).rsplit(\"/\", 1)[-1] for m in _EXTERNAL.finditer(page)]\n    if loaded:\n        # Not a fault \u2014 but a page whose popups live in one of these looks,\n        # from here, like a page that touches nothing.\n        ctx.log(f\"the page loads {len(loaded)} external script(s) \u2014 ids wired \"\n                f\"from those cannot be seen from here: \"\n                f\"{', '.join(loaded[:4])}\"\n                f\"{' \u2026' if len(loaded) > 4 else ''}\")\n    return {\"hooks\": frame}\n",
    "label": "HTML Hooks"
   },
   {
    "id": "svg_goto_html",
    "type": "flograph.util.goto",
    "pos": [
     -1400,
     -960
    ],
    "params": {
     "name": "Page HTML"
    },
    "code": null,
    "label": null
   },
   {
    "id": "svg_goto_path",
    "type": "flograph.util.goto",
    "pos": [
     -1400,
     -880
    ],
    "params": {
     "name": "Page path"
    },
    "code": null,
    "label": null
   },
   {
    "id": "svg_goto_svg",
    "type": "flograph.util.goto",
    "pos": [
     -1400,
     -800
    ],
    "params": {
     "name": "New SVG"
    },
    "code": null,
