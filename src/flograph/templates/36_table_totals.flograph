    },
    "code": null,
    "label": "5 · Totals in output"
   },
   {
    "id": "tt_matrix",
    "type": "flograph.viz.show_table",
    "pos": [
     700,
     3040
    ],
    "params": {
     "mode": "matrix",
     "matrix_rows": "Region",
     "matrix_columns": "Product",
