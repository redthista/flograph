{
  "flograph_version": "0.1.10",
  "schema": 1,
  "graph": {
    "nodes": [
      {
        "id": "t18_make",
        "type": "flograph.scripting.python_script",
        "pos": [
          0,
          600
        ],
        "params": {
          "folder": "flograph_pdf_demo"
        },
        "code": "\"\"\"Make Some PDFs\n\nWrites three small PDF files into a folder next to the project so the rest of\nthis example has something real to read. They are assembled here as bytes \u2014\nabout forty lines of it \u2014 rather than with a library, because a PDF is a text\nformat and this way the example needs nothing installed and works in a\nheadless run as well as in the app.\n\nOutputs the folder it wrote, and the path of the first document, so the\nreaders downstream get their locations from the wire rather than from a path\ntyped into a parameter that would only be right on one machine.\n\"\"\"\nNODE = {\n    \"label\": \"Make Some PDFs\",\n    \"category\": \"Scripting\",\n    \"inputs\": [],\n    \"outputs\": [(\"folder\", \"string\"), (\"first\", \"string\")],\n}\nPARAMS = [\n    {\"name\": \"folder\", \"type\": \"string\", \"label\": \"Folder\",\n     \"default\": \"flograph_pdf_demo\",\n     \"placeholder\": \"written relative to the current directory\"},\n]\n\nDOCUMENTS = {\n    \"invoice_a100.pdf\": (\"Invoice A-100\", [\n        [\"INVOICE A-100\", \"Acme Ltd\", \"\", \"Widgets  120.00\", \"Fitting   45.00\",\n         \"Total    165.00\"],\n        [\"Terms: 30 days net.\", \"Late payment attracts interest.\"],\n    ]),\n    \"invoice_b200.pdf\": (\"Invoice B-200\", [\n        [\"INVOICE B-200\", \"Globex Corp\", \"\", \"Consultancy  900.00\",\n         \"Expenses      75.50\", \"Total        975.50\"],\n    ]),\n    \"statement_q1.pdf\": (\"Q1 Statement\", [\n        [\"QUARTERLY STATEMENT\", \"Period: Q1\", \"\", \"Opening   1,200.00\",\n         \"Invoiced  1,140.50\", \"Closing   2,340.50\"],\n        [\"Notes\", \"Two invoices were raised this quarter.\",\n         \"Both remain outstanding at the period end.\"],\n        [\"Prepared for internal review only.\"],\n    ]),\n}\n\n\ndef build_pdf(pages, title=\"\"):\n    \"\"\"A minimal single-font PDF as bytes.\n\n    `pages` is a list of pages, each a list of lines. Everything here is\n    plain PDF syntax: a catalogue, a page tree, one Helvetica font, and a\n    content stream per page that positions text and draws it.\n    \"\"\"\n    def esc(text):\n        return (str(text).replace(\"\\\\\", r\"\\\\\")\n                .replace(\"(\", r\"\\(\").replace(\")\", r\"\\)\"))\n\n    objects, page_ids = [], []\n    objects.append(\"<< /Type /Catalog /Pages 2 0 R >>\")\n    objects.append(None)  # the page tree, filled in once the page ids exist\n    objects.append(\"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\")\n    for lines in pages:\n        content = [\"BT\", \"/F1 16 Tf\", \"24 TL\", \"72 760 Td\"]\n        for line in lines:\n            content.append(f\"({esc(line)}) Tj T*\")\n        content.append(\"ET\")\n        stream = \"\\n\".join(content)\n        objects.append(\n            \"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] \"\n            \"/Resources << /Font << /F1 3 0 R >> >> \"\n            f\"/Contents {len(objects) + 2} 0 R >>\")\n        page_ids.append(len(objects))\n        objects.append(\n            f\"<< /Length {len(stream)} >>\\nstream\\n{stream}\\nendstream\")\n\n    info_ref = 0\n    if title:\n        # An indirect object, not a dictionary written inline in the trailer:\n        # readers follow /Info as a reference and ignore anything else.\n        objects.append(f\"<< /Title ({esc(title)}) >>\")\n        info_ref = len(objects)\n    objects[1] = (\"<< /Type /Pages /Kids [\"\n                  + \" \".join(f\"{i} 0 R\" for i in page_ids)\n                  + f\"] /Count {len(pages)} >>\")\n\n    out = bytearray(b\"%PDF-1.4\\n\")\n    offsets = []\n    for number, body in enumerate(objects, 1):\n        offsets.append(len(out))\n        out += f\"{number} 0 obj\\n{body}\\nendobj\\n\".encode(\"latin-1\")\n    xref_at = len(out)\n    out += f\"xref\\n0 {len(objects) + 1}\\n\".encode(\"latin-1\")\n    out += b\"0000000000 65535 f \\n\"\n    for offset in offsets:\n        out += f\"{offset:010d} 00000 n \\n\".encode(\"latin-1\")\n    info = f\" /Info {info_ref} 0 R\" if info_ref else \"\"\n    out += (f\"trailer\\n<< /Size {len(objects) + 1} /Root 1 0 R{info} >>\\n\"\n            f\"startxref\\n{xref_at}\\n%%EOF\\n\").encode(\"latin-1\")\n    return bytes(out)\n\n\ndef run(ctx):\n    import os\n\n    folder = os.path.abspath(ctx.params[\"folder\"] or \"flograph_pdf_demo\")\n    os.makedirs(folder, exist_ok=True)\n    written = []\n    for name, (title, pages) in sorted(DOCUMENTS.items()):\n        path = os.path.join(folder, name)\n        with open(path, \"wb\") as handle:\n            handle.write(build_pdf(pages, title))\n        written.append(path)\n        ctx.log(f\"wrote {name} ({len(pages)} page(s))\")\n    ctx.log(f\"{len(written)} document(s) in {folder}\")\n    return {\"folder\": folder, \"first\": written[0]}\n",
        "label": "Make Some PDFs"
      },
