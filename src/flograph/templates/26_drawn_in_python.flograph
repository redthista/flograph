          "data": "{\"version\": 2, \"columns\": [{\"name\": \"region\", \"type\": \"text\"}, {\"name\": \"quarter\", \"type\": \"text\"}, {\"name\": \"revenue\", \"type\": \"number\"}], \"rows\": [[\"London\", \"Q1\", 612], [\"London\", \"Q2\", 648], [\"London\", \"Q3\", 671], [\"London\", \"Q4\", 704], [\"South East\", \"Q1\", 498], [\"South East\", \"Q2\", 486], [\"South East\", \"Q3\", 495], [\"South East\", \"Q4\", 502], [\"North West\", \"Q1\", 352], [\"North West\", \"Q2\", 366], [\"North West\", \"Q3\", 379], [\"North West\", \"Q4\", 388], [\"East of England\", \"Q1\", 338], [\"East of England\", \"Q2\", 344], [\"East of England\", \"Q3\", 349], [\"East of England\", \"Q4\", 351], [\"West Midlands\", \"Q1\", 281], [\"West Midlands\", \"Q2\", 292], [\"West Midlands\", \"Q3\", 298], [\"West Midlands\", \"Q4\", 302], [\"South West\", \"Q1\", 301], [\"South West\", \"Q2\", 296], [\"South West\", \"Q3\", 291], [\"South West\", \"Q4\", 288], [\"Yorkshire and The Humber\", \"Q1\", 226], [\"Yorkshire and The Humber\", \"Q2\", 238], [\"Yorkshire and The Humber\", \"Q3\", 244], [\"Yorkshire and The Humber\", \"Q4\", 251], [\"East Midlands\", \"Q1\", 219], [\"East Midlands\", \"Q2\", 221], [\"East Midlands\", \"Q3\", 223], [\"East Midlands\", \"Q4\", 224], [\"Scotland\", \"Q1\", 178], [\"Scotland\", \"Q2\", 186], [\"Scotland\", \"Q3\", 191], [\"Scotland\", \"Q4\", 196], [\"North East\", \"Q1\", 108], [\"North East\", \"Q2\", 114], [\"North East\", \"Q3\", 118], [\"North East\", \"Q4\", 121], [\"Wales\", \"Q1\", 102], [\"Wales\", \"Q2\", 99], [\"Wales\", \"Q3\", 97], [\"Wales\", \"Q4\", 96], [\"Northern Ireland\", \"Q1\", 74], [\"Northern Ireland\", \"Q2\", 78], [\"Northern Ireland\", \"Q3\", 81], [\"Northern Ireland\", \"Q4\", 84]]}",
