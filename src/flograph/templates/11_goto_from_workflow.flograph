          "data": "{\"columns\": [\"region\", \"target\"], \"rows\": [[\"North\", 4000], [\"South\", 1000], [\"East\", 1500], [\"West\", 3000]]}",
          "width": 280,
          "height": 140
        },
        "code": null,
        "label": "Targets"
      },
      {
        "id": "gt_clean",
        "type": "flograph.transform.filter_rows",
