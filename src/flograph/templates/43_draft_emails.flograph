   {
    "id": "t43_how",
    "type": "flograph.util.note",
    "pos": [
     0,
     360
    ],
    "params": {
     "text": "Draft Emails reads columns named **to**, **cc**, **bcc**, **subject** and **body**. Several addresses in one cell go in with `;` or `,` (Carol's row). **Most emails** (20) stops a big table opening a window per row. Edit the templates in *Write the emails*: any column in braces, like `{invoice}`.\n\n`mailto:` can't attach files.",
     "width": 1300,
     "height": 120
    },
    "code": null,
    "label": null
   }
