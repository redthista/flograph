        "params": {
          "data": "{\"version\": 2, \"columns\": [{\"name\": \"region\", \"type\": \"text\"}, {\"name\": \"manager\", \"type\": \"text\"}, {\"name\": \"target\", \"type\": \"number\"}], \"rows\": [[\"north\", \"Ada\", 1000.0], [\"south\", \"Ben\", 500.0], [\"east\", \"Cy\", 800.0]]}",
          "width": 320,
          "height": 180
        },
        "code": null,
        "label": "Regions"
      },
      {
        "id": "rank",
        "type": "flograph.transform.window_function",
        "pos": [
          620,
          660
        ],
        "params": {
          "function": "rank",
          "partition_by": "region",
          "order_by": "amount",
          "descending": true,
          "output_column": "rank_in_region"
        },
        "code": null,
        "label": "Rank in region"
      },
      {
        "id": "duck",
        "type": "flograph.connect.duckdb_query",
        "pos": [
          620,
          840
        ],
        "params": {
          "query": "SELECT a.region, b.manager, sum(a.amount) AS spend, b.target,\n       round(100.0*sum(a.amount)/b.target, 1) AS pct_of_target\nFROM a JOIN b USING (region)\nGROUP BY 1, 2, 4 ORDER BY spend DESC"
        },
        "code": null,
        "label": "Spend vs target"
      },
