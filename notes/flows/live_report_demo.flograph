     "totals": "sum",
     "format_rules": "Revenue_*  heading \"Revenue\" sum\nUnits_*    heading \"Units\" folded\nRevenue_Q1, Units_Q1  label \"Q1\"\nRevenue_Q2, Units_Q2  label \"Q2\"\nRevenue_*, Revenue  format $,.0f\ntrend  spark area teal last from Revenue_Q1, Revenue_Q2 totals",
     "width": 820,
     "height": 520
    },
    "code": null,
    "label": "8 \u00b7 Headings, and sparks on the groups"
   },
   {
    "id": "tt_head_groups_note",
    "type": "flograph.util.note",
    "pos": [
     1620,
     4240
    ],
    "params": {
     "text": "**8 \u00b7 Headings you fold, sparks on the groups.** A pivot to one column per quarter for revenue and for units, grouped by region. Each value heads its quarters, and the two fold differently: **Revenue** says `sum`, so folding it leaves one column holding the row's total; **Units** says nothing, so it folds to a narrow blank `\u22ef` column \u2014 there only to click open again \u2014 and starts `folded`. The `trend` spark ends in `totals`, so each region's row and the grand total draw their revenue by quarter too \u2014 fold a region and its trend is still there.",
     "width": 520,
     "height": 260
    },
    "code": null,
    "label": null
   },
