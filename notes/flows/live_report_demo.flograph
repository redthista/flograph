   {
    "id": "lr_map",
    "type": "flograph.scripting.python_script",
    "pos": [
     -700,
     1120
    ],
    "params": {},
    "code": "\"\"\"Revenue by Country\n\nA Plotly world map \u2014 drawn on the 1:110m outlines that ship with flograph,\nso it needs no network on the card, in the report's picture, or live in a\nsaved web page.\n\"\"\"\nNODE = {\n    \"label\": \"Revenue by Country\",\n    \"category\": \"Viz\",\n    \"version\": \"1.0\",\n    \"card\": \"webview\",\n    # nothing wired in, so it starts with the first nodes of a run \u2014 and\n    # importing plotly.express beside another node's first pandas import\n    # raced (\"partially initialized module 'pandas'\"). Alone, it cannot.\n    \"exclusive\": True,\n    \"inputs\": [],\n    \"outputs\": [(\"figure\", \"object\")],\n}\nPARAMS = []\n\n\ndef run(ctx, **inputs):\n    import plotly.express as px\n    countries = [\"GBR\", \"FRA\", \"DEU\", \"ESP\", \"ITA\", \"USA\", \"CAN\", \"BRA\",\n                 \"IND\", \"CHN\", \"JPN\", \"AUS\", \"ZAF\", \"MEX\", \"SWE\"]\n    revenue = [59, 41, 47, 22, 19, 88, 27, 14, 31, 52, 36, 18, 9, 12, 11]\n    fig = px.choropleth(locations=countries, color=revenue,\n                        color_continuous_scale=\"Tealgrn\",\n                        labels={\"color\": \"Revenue \u00a3k\"},\n                        title=\"Revenue by country\")\n    fig.update_geos(showcountries=True, countrycolor=\"#9aa4b8\",\n                    showocean=True, oceancolor=\"#eef3f8\",\n                    projection_type=\"natural earth\")\n    fig.update_layout(margin={\"l\": 10, \"r\": 10, \"t\": 50, \"b\": 10})\n    return {\"figure\": fig}\n",
    "label": "Revenue by Country"
   }
  ],
