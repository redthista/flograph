    "params": {
     "text": "**Marks pinned right.** ▲ / ▼ sit against the cell's right edge (`.fg-pr`, two spans), and the status lights keep their colours — under Slate they used to all come out dark grey.",
     "width": 520,
     "height": 120
    }
