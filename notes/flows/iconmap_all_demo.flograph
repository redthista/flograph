     "format_rules": "# gap 0 — the icons touch (the gap to the text stays)\nTags    iconmap all gap 0: *fix*=🔧, *test*=🧪 green, *late*=🔥, *docs*=📘, *perf*=⚡ amber\n",
     "hide": "Owner, Note, Amount",
