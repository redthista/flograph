        "code": "\"\"\"Polite step \u2014 works in small slices and checks for Stop between them,\nso Stop ends it straight away.\"\"\"\nNODE = {\n    \"label\": \"Polite Step\",\n    \"category\": \"Scripting\",\n    \"version\": \"1.0\",\n    \"inputs\": [(\"table\", \"dataframe\")],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = [{\"name\": \"seconds\", \"type\": \"float\", \"default\": 0.6}]\n\n\ndef run(ctx, table):\n    import time\n    slices = 30\n    for i in range(slices):\n        ctx.check_cancelled()\n        ctx.progress(i / slices)\n        time.sleep(ctx.params[\"seconds\"] / slices)\n    out = table.copy()\n    out[\"value\"] = out[\"value\"] * 1.01 + 1\n    out[\"name\"] = out[\"name\"].astype(object)\n    return {\"table\": out}\n",
