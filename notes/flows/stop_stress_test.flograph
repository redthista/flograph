        "params": {
          "seconds": 2.5
        },
        "code": "\"\"\"Stubborn step \u2014 one long call that never checks for Stop, like a slow\ndatabase read or a big pandas operation. Stop walks away from it: its light\nsays \"stopping\", it finishes in the background, and its result is thrown\naway.\"\"\"\nNODE = {\n    \"label\": \"Stubborn Step\",\n    \"category\": \"Scripting\",\n    \"version\": \"1.0\",\n    \"inputs\": [(\"table\", \"dataframe\")],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = [{\"name\": \"seconds\", \"type\": \"float\", \"default\": 2.5}]\n\n\ndef run(ctx, table):\n    import time\n    time.sleep(ctx.params[\"seconds\"])\n    out = table.copy()\n    out[\"value\"] = out[\"value\"] - 0.5\n    out[\"name\"] = out[\"name\"].astype(object)\n    return {\"table\": out}\n",
        "label": "Stubborn 35.9",
