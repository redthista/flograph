    "nodes": [
      {
        "id": "d49bd4ed4dc74c728bf9872f8fdd72a4",
        "type": "flograph.scripting.python_script",
        "pos": [
          -392.0,
          3315.0
        ],
        "params": {
          "rows": 100000,
          "seed": 0
        },
        "code": "\"\"\"Make Data \u2014 the one source every chain reads.\n\nRaise `rows` to make each step heavier (memory grows with it: every step\ncaches its own copy).\n\"\"\"\nNODE = {\n    \"label\": \"Make Data\",\n    \"category\": \"Scripting\",\n    \"version\": \"1.0\",\n    \"inputs\": [],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = [{\"name\": \"rows\", \"type\": \"int\", \"default\": 100000},\n          {\"name\": \"seed\", \"type\": \"int\", \"default\": 0}]\n\n\ndef run(ctx):\n    import numpy as np\n    import pandas as pd\n    n = ctx.params[\"rows\"]\n    rng = np.random.default_rng(ctx.params[\"seed\"])\n    names = np.array([f\"customer {i:05d}\" for i in range(5000)], dtype=object)\n    return {\"table\": pd.DataFrame({\n        \"name\": names[rng.integers(0, 5000, n)].astype(object),\n        \"region\": rng.choice([\"north\", \"south\", \"east\", \"west\"], n),\n        \"value\": rng.random(n) * 100,\n    })}\n",
        "label": "Make Data",
        "description": "",
        "active": true,
        "locked": false,
        "frozen": false,
        "manual": false,
        "frozen_fingerprint": null,
        "exclusive": null,
        "preview": true,
        "port_labels": null,
        "flow_pins": null,
        "ports_collapsed": false,
        "color": null,
        "compact_view": null,
        "mark": "",
        "mark_text": "",
        "mark_image": "",
        "z": 0,
        "extra_inputs": []
      },
      {
        "id": "cc5f5d66e3bb4c3185faf7367286d2c1",
        "type": "flograph.scripting.python_script",
        "pos": [
          0,
          0
        ],
        "params": {
          "seconds": 2.5
        },
        "code": "\"\"\"Stubborn step \u2014 one long call that never checks for Stop, like a slow\ndatabase read or a big pandas operation. Stop walks away from it: its light\nsays \"stopping\", it finishes in the background, and its result is thrown\naway.\"\"\"\nNODE = {\n    \"label\": \"Stubborn Step\",\n    \"category\": \"Scripting\",\n    \"version\": \"1.0\",\n    \"inputs\": [(\"table\", \"dataframe\")],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = [{\"name\": \"seconds\", \"type\": \"float\", \"default\": 2.5}]\n\n\ndef run(ctx, table):\n    import time\n    time.sleep(ctx.params[\"seconds\"])\n    out = table.copy()\n    out[\"value\"] = out[\"value\"] - 0.5\n    out[\"name\"] = out[\"name\"].astype(object)\n    return {\"table\": out}\n",
        "label": "Stubborn 1.1",
        "description": "",
        "active": true,
        "locked": false,
        "frozen": false,
        "manual": false,
        "frozen_fingerprint": null,
        "exclusive": null,
        "preview": true,
        "port_labels": null,
        "flow_pins": null,
        "ports_collapsed": false,
        "color": null,
        "compact_view": null,
        "mark": "",
        "mark_text": "",
        "mark_image": "",
        "z": 1,
        "extra_inputs": []
      },
      {
        "id": "5a40dddfc14e41e8ab7e8a397a33002f",
        "type": "flograph.scripting.python_script",
        "pos": [
          280,
          0
        ],
        "params": {
          "seconds": 0.6
        },
        "code": "\"\"\"Polite step \u2014 works in small slices and checks for Stop between them,\nso Stop ends it straight away.\"\"\"\nNODE = {\n    \"label\": \"Polite Step\",\n    \"category\": \"Scripting\",\n    \"version\": \"1.0\",\n    \"inputs\": [(\"table\", \"dataframe\")],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = [{\"name\": \"seconds\", \"type\": \"float\", \"default\": 0.6}]\n\n\ndef run(ctx, table):\n    import time\n    slices = 30\n    for i in range(slices):\n        ctx.check_cancelled()\n        ctx.progress(i / slices)\n        time.sleep(ctx.params[\"seconds\"] / slices)\n    out = table.copy()\n    out[\"value\"] = out[\"value\"] * 1.01 + 1\n    out[\"name\"] = out[\"name\"].astype(object)\n    return {\"table\": out}\n",
        "label": "Polite 1.2",
        "description": "",
        "active": true,
        "locked": false,
        "frozen": false,
        "manual": false,
        "frozen_fingerprint": null,
        "exclusive": null,
