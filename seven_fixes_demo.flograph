      },
      {
        "id": "note_copy",
        "type": "flograph.util.note",
        "pos": [
          0,
          2200
        ],
        "params": {
          "text": "## 3 · Copy code with its indents  (Y1)\n\nOpen this node's **Code** tab, select the `run` function, Ctrl+C, and paste it into an email. The indentation now survives an ordinary paste — no \"paste as unformatted\" needed.\n\n## 4 · Report header tone  (U1)\n\nOpen the **Report** page tab. Both tables have a toned header row now; before, only the one with `|fit` did.",
          "width": 520,
          "height": 280
        },
        "code": null,
        "label": null
      },
      {
        "id": "from_copy",
        "type": "flograph.util.goto_from",
        "pos": [
          620,
          2300
        ],
        "params": {
          "source": "publish"
        },
        "code": null,
        "label": null
      },
      {
        "id": "copy_me",
        "type": "flograph.scripting.python_script",
        "pos": [
          920,
          2240
        ],
        "params": {},
        "code": "\"\"\"Copy me\n\nSelect this whole function and copy it (Ctrl+C), then paste into an email\nor a Word document. Before the fix the indentation vanished unless you\nused \"paste as unformatted\"; now the ordinary paste keeps it.\n\"\"\"\nNODE = {\n    \"label\": \"Copy me\",\n    \"category\": \"Scripting\",\n    \"inputs\": [(\"table\", \"dataframe\")],\n    \"outputs\": [(\"table\", \"dataframe\")],\n}\nPARAMS = []\n\n\ndef run(ctx, table):\n    \"\"\"Deliberately deeply indented, so a lost indent is obvious.\"\"\"\n    out = table.copy()\n    for name in out.columns:\n        if name.startswith(\"20\"):\n            if out[name].sum() > 0:\n                ctx.log(f\"{name}: {int(out[name].sum())} flagged\")\n            else:\n                ctx.log(f\"{name}: nothing flagged\")\n    return {\"table\": out}\n",
        "label": "Copy me"
      }
    ],
